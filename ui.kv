                halign: "left"
                valign: "top"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

        ClayButton:
            text: app.language and (app.t('btn_close'))
            bg_color: app.accent
            size_hint_y: None
            height: dp(48)
            on_release: root.dismiss()


<TimePickerPopup>:
    title: root.titulo
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.accent
    background: ""
    background_color: app.bg_app
    size_hint: 0.86, None
    height: dp(330)
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        BoxLayout:
            size_hint_y: None
            height: dp(180)
            spacing: dp(6)

            # coluna da HORA
            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                ClayButton:
                    text: "+"
                    bg_color: app.accent_soft
                    text_color: app.text_dark
                    on_release: root.mexer("hora", 1)
                Label:
                    text: "%02d" % root.hora
                    font_name: TITLE_FONT
                    bold: True
                    font_size: "40sp"
                    color: app.text_dark
                ClayButton:
                    text: "-"
                    bg_color: app.accent_soft
                    text_color: app.text_dark
                    on_release: root.mexer("hora", -1)

            Label:
                text: ":"
                font_name: TITLE_FONT
                bold: True
                font_size: "34sp"
                color: app.muted
                size_hint_x: None
                width: dp(18)

            # coluna do MINUTO: +1 e +5, porque 60 valores de 1 em 1 seriam
            # muitos toques pra chegar em, digamos, :45
            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                BoxLayout:
                    spacing: dp(4)
                    ClayButton:
                        text: "+1"
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        on_release: root.mexer("minuto", 1)
                    ClayButton:
                        text: "+5"
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        on_release: root.mexer("minuto", 5)
                Label:
                    text: "%02d" % root.minuto
                    font_name: TITLE_FONT
                    bold: True
                    font_size: "40sp"
                    color: app.text_dark
                BoxLayout:
                    spacing: dp(4)
                    ClayButton:
                        text: "-1"
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        on_release: root.mexer("minuto", -1)
                    ClayButton:
                        text: "-5"
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        on_release: root.mexer("minuto", -5)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)

            ClayButton:
                text: app.language and (app.t('btn_cancel'))
                bg_color: app.bg_card
                text_color: app.text_dark
                on_release: root.dismiss()

            ClayButton:
                text: (root.hora, root.minuto) and root.texto()
                bg_color: app.accent
                text_color: app.text_light
                on_release: root.confirmar()


<ConfirmPopup>:
    # confirmação de ação sem desfazer (apagar missão) — ver App.on_remove_mission.
    # auto_dismiss False de propósito: sair tocando fora é ambíguo aqui, tem
    # que ser um "Cancelar" explícito.
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.danger
    background: ""
    background_color: app.bg_app
    size_hint: 0.88, None
    height: confirm_box.height + dp(64)
    auto_dismiss: False

    BoxLayout:
        id: confirm_box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16)
        spacing: dp(14)

        Label:
            text: root.message
            color: app.text_dark
            font_size: "15sp"
            halign: "center"
            valign: "middle"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)

            ClayButton:
                text: app.language and (app.t('btn_cancel'))
                bg_color: app.bg_card
                text_color: app.text_dark
                on_release: root.dismiss()

            ClayButton:
                id: confirm_delete_button
                text: root.confirm_text
                bg_color: app.danger
                text_color: app.text_light
                on_release: root.confirm()


<ApagarContaPopup>:
    # último passo de apagar a conta (App._enviar_codigo_apagar). auto_dismiss
    # False: sair tocando fora é ambíguo numa ação sem volta
    title: app.language and (app.t('delete_code_title'))
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.danger
    background: ""
    background_color: app.bg_app
    size_hint: 0.9, None
    height: apagar_box.height + dp(64)
    auto_dismiss: False

    BoxLayout:
        id: apagar_box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16)
        spacing: dp(12)

        Label:
            text: app.language and (app.t('delete_code_body').format(email=root.email))
            color: app.text_dark
            font_size: "14sp"
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        TextInput:
            id: codigo_input
            hint_text: app.language and (app.t('field_code_hint'))
            input_filter: "int"
            multiline: False
            halign: "center"
            font_size: "22sp"
            size_hint_y: None
            height: dp(52)
            background_color: app.bg_card
            foreground_color: app.text_dark

        Label:
            text: root.erro
            color: app.danger
            font_size: "12sp"
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1] if root.erro else 0
            text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)

            ClayButton:
                text: app.language and (app.t('btn_cancel'))
                bg_color: app.bg_card
                text_color: app.text_dark
                on_release: root.dismiss()

            ClayButton:
                text: app.language and (app.t('btn_delete_forever'))
                bg_color: app.danger
                text_color: app.text_light
                on_release: root.confirmar()


<ReminderPopup>:
    # notificação DENTRO do app (a de sistema é best-effort) — curta, some ao
    # tocar em qualquer lugar. Ver App._fire_reminder / _check_reminder.
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.accent
    background: ""
    background_color: app.bg_app
    size_hint: 0.88, None
    height: content_box.height + dp(64)
    auto_dismiss: True

    BoxLayout:
        id: content_box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16)
        spacing: dp(14)

        Label:
            text: root.message
            color: app.text_dark
            font_size: "15sp"
            halign: "center"
            valign: "middle"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        ClayButton:
            text: app.language and (app.t('btn_close'))
            bg_color: app.accent
            size_hint_y: None
            height: dp(46)
            on_release: root.dismiss()


<AlarmeView>:
    # tela cheia do alarme de missão (App.abrir_alarme). auto_dismiss False:
    # tocar fora não encerra alarme sem querer, só o botão
    auto_dismiss: False
    size_hint: 1, 1
    background: ""
    background_color: app.bg_app
    overlay_color: app.bg_app

    BoxLayout:
        orientation: "vertical"
        padding: dp(28), dp(40)
        spacing: dp(10)

        Label:
            text: root.horario
            font_name: TITLE_FONT
            bold: True
            font_size: "68sp"
            color: app.accent
            size_hint_y: None
            height: dp(84)

        Label:
            text: app.language and (app.t('alarm_title'))
            color: app.muted
            font_size: "18sp"
            size_hint_y: None
            height: dp(26)

        Image:
            source: "assets/focum/focum_alarm.png"
            allow_stretch: True
            keep_ratio: True

        Label:
            text: root.mission_name
            font_name: TITLE_FONT
            bold: True
            font_size: "32sp"
            color: app.text_dark
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] + dp(8)

        Widget:
            size_hint_y: None
            height: dp(18)

        ClayButton:
            text: app.language and (app.t('btn_stop_alarm'))
            bg_color: app.danger
            text_color: app.text_light
            size_hint_y: None
            height: dp(64)
            on_release: root.dismiss()


# pílula dos atalhos no topo da aba Missões: mesmo relevo dos botões (lábio
# embaixo, afunda ao tocar), contorno na cor de destaque
<ChipButton@ButtonBehavior+Label>:
    color: app.text_dark
    font_size: FS_BODY
    bold: True
    size_hint_x: None
    width: self.texture_size[0] + dp(28)
    # o texto desce junto com a face (4dp de padding trocam de lado)
    padding: (0, dp(4), 0, 0) if self.state == "down" else (0, 0, 0, dp(4))
    canvas.before:
        Color:
            rgba: lip(app.accent, app.text_dark)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [(self.height - dp(4)) / 2]
        Color:
            rgba: app.bg_card_soft
        RoundedRectangle:
            pos: self.x + dp(2), self.y + (dp(2) if self.state == "down" else dp(4))
            size: self.width - dp(4), self.height - dp(6)
            radius: [(self.height - dp(6)) / 2]


<SuggestionsPopup>:
    title: app.language and (app.t('mission_suggestions_title'))
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.accent
    background: ""
