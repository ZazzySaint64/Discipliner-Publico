<RewardFormPopup>:
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.accent
    background: ""
    background_color: app.bg_app
    size_hint: 0.85, None
    height: dp(300)

    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(10)

        FieldLabel:
            text: app.language and (app.t('field_reward_name'))

        TextInput:
            id: reward_name_input
            hint_text: app.language and (app.t('reward_name_hint'))
            multiline: False
            size_hint_y: None
            height: dp(42)
            background_color: app.bg_card_soft
            foreground_color: app.text_dark

        FieldLabel:
            text: app.language and (app.t('field_reward_cost'))

        TextInput:
            id: reward_cost_input
            hint_text: "20"
            multiline: False
            input_filter: "int"
            size_hint_y: None
            height: dp(42)
            background_color: app.bg_card_soft
            foreground_color: app.text_dark

        Widget:

        ClayButton:
            id: reward_confirm_button
            bg_color: app.accent
            size_hint_y: None
            height: dp(48)
            on_release: root.confirm()


<MissionDetailPopup>:
    # sem título/separador automático do Popup (o espaçamento interno dele é
    # fixo e não dava pra controlar) — o nome da missão vira só mais um Label
    # dentro do nosso próprio layout, com o respiro que a gente quiser
    title: ""
    separator_height: 0
    background: ""
    background_color: 0, 0, 0, 0
    # fração da tela (não dp fixo): instruções são texto livre, de tamanho
    # variável — um dp fixo cedo ou tarde ia ficar curto ou sobrar demais
    size_hint: 0.85, 0.8
    # bordas redondas + contorno um tom mais escuro que o próprio fundo —
    # mesma receita do ClayCard/ClayButton (retângulo arredondado + Line por
    # cima), porque o retângulo que o ModalView desenha sozinho é quadrado.
    # Usa bg_card_soft (o tom mais claro de cartão que o app tem). Os cartões
    # de campo (mais abaixo) usam bg_card, um tom abaixo, pra continuarem
    # distinguíveis do fundo da aba — 2 níveis: aba < cartões dela.
    # overlay_color zerado: o ModalView (Popup) desenha por padrão uma
    # cortina escurecendo a TELA INTEIRA (inclusive por cima da nossa aba,
    # já que ela roda depois do canvas.before) — com background_color
    # transparente (mais abaixo) nada cancelava essa cortina aqui, então a
    # aba saía sempre escurecida, em qualquer tema. Só essa aba perde o
    # escurecimento do fundo; as outras (que usam background_color opaco)
    # continuam normais.
    overlay_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: app.bg_card_soft
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: app.bg_card_soft[0] * 0.7, app.bg_card_soft[1] * 0.7, app.bg_card_soft[2] * 0.7, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(1.4)

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        # título — nome inteiro da missão, sem o corte "..." que a linha usa
        Label:
            text: root.nome_da_missao
            color: app.text_dark
            bold: True
            font_size: "20sp"
            halign: "center"
            valign: "middle"
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] + dp(8)

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: 0, 0, dp(4), 0

                # cada campo é sua própria fileira (rótulo à esquerda, valor
                # em destaque à direita) — mesmo estilo já usado em
                # Sequências pro "Melhor" (streak_best_label)
                ClayCard:
                    bg_color: app.bg_card
                    orientation: "horizontal"
                    padding: dp(14)
                    size_hint_y: None
                    height: dp(52)

                    Label:
                        text: app.language and (app.t('field_periodicity'))
                        color: app.muted
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        text: root.periodicidade
                        color: app.text_dark
                        bold: True
                        halign: "right"
                        valign: "middle"
                        text_size: self.size

                ClayCard:
                    bg_color: app.bg_card
                    orientation: "horizontal"
                    padding: dp(14)
                    size_hint_y: None
                    height: dp(52)

                    Label:
                        text: app.language and (app.t('field_difficulty'))
                        color: app.muted
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        text: root.dificuldade
                        color: app.difficulty_color(root.difficulty_key)
                        bold: True
                        halign: "right"
                        valign: "middle"
                        text_size: self.size

                ClayCard:
                    bg_color: app.bg_card
                    orientation: "horizontal"
                    padding: dp(14)
                    size_hint_y: None
                    height: dp(52)

                    Label:
                        text: app.language and (app.t('field_points'))
                        color: app.muted
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        text: "+" + root.pontuacao
                        color: app.accent
                        bold: True
                        halign: "right"
                        valign: "middle"
                        text_size: self.size

                # instruções — texto livre (ex.: exercícios do treino), só
                # aparece quando a missão tem alguma coisa escrita ali
                ClayCard:
                    bg_color: app.bg_card
                    orientation: "vertical"
                    padding: dp(14)
                    spacing: dp(6)
                    size_hint_y: None
                    height: self.minimum_height if root.instrucoes else 0
                    opacity: 1 if root.instrucoes else 0

                    Label:
                        text: app.language and (app.t('field_instructions'))
                        color: app.muted
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]

                    Label:
                        text: root.instrucoes
                        color: app.text_dark
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]

        ClayButton:
            text: app.language and (app.t('btn_close'))
            bg_color: app.accent_soft
            text_color: app.text_dark
            size_hint_y: None
            height: dp(44)
            on_release: root.dismiss()


<BadgeDetailPopup>:
    # mesma receita do MissionDetailPopup (ver comentários lá) — título e
    # fundo próprios, sem o do Popup padrão do Kivy
    title: ""
    separator_height: 0
    background: ""
    background_color: 0, 0, 0, 0
    size_hint: 0.85, None
    # +52dp quando o botão de certificado aparece (emblema de sequência
    # diária desbloqueado) — senão o espaçador vazio absorve a diferença
    height: dp(320) + (dp(52) if root.milestone_days and root.unlocked else 0)
    overlay_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: app.bg_card_soft
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: app.bg_card_soft[0] * 0.7, app.bg_card_soft[1] * 0.7, app.bg_card_soft[2] * 0.7, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(1.4)

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        Label:
            text: root.nome_do_emblema
            color: app.text_dark
            bold: True
            font_size: "20sp"
            halign: "center"
            valign: "middle"
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] + dp(8)

        ClayCard:
            bg_color: app.bg_card
            orientation: "vertical"
            padding: dp(14)
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: root.descricao
                color: app.text_dark
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

        Label:
            text: "" if root.unlocked else app.t('badge_locked_hint')
            color: app.danger
            bold: True
            font_size: "11sp"
            halign: "center"
            valign: "middle"
            text_size: self.width, None
            size_hint_y: None
            height: (self.texture_size[1] + dp(4)) if not root.unlocked else 0

        Widget:

        # só dá pra equipar um emblema já desbloqueado
        ClayButton:
            text: app.t('btn_unequip_title') if root.equipped else app.t('btn_equip_title')
            bg_color: app.bg_card_soft if root.equipped else app.accent
            text_color: app.text_dark if root.equipped else app.text_light
            size_hint_y: None
            height: dp(44) if root.unlocked else 0
            opacity: 1 if root.unlocked else 0
            disabled: not root.unlocked
            on_release: root.toggle_equip()

        # certificado compartilhável — só pros marcos de sequência DIÁRIA
        # (streak_3/7/14/30/100, ver main.DAILY_STREAK_MILESTONES) já desbloqueados
        ClayButton:
            text: app.language and (app.t('btn_share_certificate'))
            bg_color: app.accent
            size_hint_y: None
            height: dp(44) if (root.milestone_days and root.unlocked) else 0
            opacity: 1 if (root.milestone_days and root.unlocked) else 0
            disabled: not (root.milestone_days and root.unlocked)
            on_release: app.share_milestone_certificate(root.milestone_days)

        ClayButton:
            text: app.language and (app.t('btn_close'))
            bg_color: app.accent_soft
            text_color: app.text_dark
            size_hint_y: None
            height: dp(44)
            on_release: root.dismiss()


<TextPopup>:
    # popup genérico só-leitura — usado pra política de privacidade e termos de uso
    title_color: app.text_dark
    title_align: "center"
