            bg_color: app.accent_soft
            text_color: app.text_dark
            size_hint_y: None
            height: dp(44)
            on_release: root.dismiss()


<ChallengesPopup>:
    title: app.language and (app.t('challenges_title'))
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.accent
    background: ""
    background_color: app.bg_app
    size_hint: 0.9, 0.7

    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(10)

        Label:
            text: app.language and (app.t('challenges_multiplier_note'))
            color: app.success
            bold: True
            font_size: "12sp"
            halign: "center"
            valign: "top"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        ScrollView:
            GridLayout:
                id: challenges_list
                cols: 1
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

        ClayButton:
            text: app.language and (app.t('btn_close'))
            bg_color: app.accent_soft
            text_color: app.text_dark
            size_hint_y: None
            height: dp(44)
            on_release: root.dismiss()


# miniatura de banner na tela de perfil — BannerArt pequeno + anel de
# seleção / contorno tracejado pro "none" (esses dois no canvas.after da
# classe, ver widgets.BannerThumb)
<BannerThumb>:
    size_hint: None, None
    size: dp(96), dp(52)
    BannerArt:
        size_hint: None, None
        pos: root.pos
        size: root.size
        pattern: root.pattern
        color: root.color


# Overlay do tutorial guiado — adicionado ao Window por main.build(), não é
# filho do root. O desenho (scrim + contorno + seta) é feito no _redraw da
# classe (widgets.TutorialOverlay); aqui só o card de texto + botões.
<TutorialOverlay>:
    size: Window.size
    pos: 0, 0

    BoxLayout:
        id: tut_card
        orientation: "vertical"
        size_hint: None, None
        width: min(dp(320), root.width - dp(32))
        height: self.minimum_height
        x: root.card_x
        y: root.card_y
        padding: dp(16)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: app.bg_card
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(14)]
            Color:
                rgba: 0.29, 0.87, 0.5, 1
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
                width: dp(1.5)

        Label:
            text: root.title_text
            font_name: TITLE_FONT
            color: app.text_dark
            bold: True
            font_size: "17sp"
            halign: "left"
            valign: "middle"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        Label:
            text: root.body_text
            color: app.text_dark
            font_size: "13sp"
            halign: "left"
            valign: "top"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        Label:
            text: root.progress_text
            color: app.muted
            font_size: "10sp"
            halign: "left"
            size_hint_y: None
            height: dp(14)
            text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)

            ClayButton:
                text: app.language and (app.t('btn_back'))
                bg_color: app.bg_card_soft
                text_color: app.muted
                size_hint_x: None
                width: dp(78) if not root.is_first else 0
                opacity: 0 if root.is_first else 1
                disabled: root.is_first
                on_release: app.tutorial_back()

            ClayButton:
                text: app.language and (app.t('btn_skip'))
                bg_color: app.bg_card_soft
                text_color: app.muted
                size_hint_x: None
                width: dp(70) if not root.is_last else 0
                opacity: 0 if root.is_last else 1
                disabled: root.is_last
                on_release: app.tutorial_skip()

            ClayButton:
                text: app.language and (app.t('btn_finish') if root.is_last else app.t('btn_next'))
                bg_color: app.accent
                on_release: app.tutorial_next()


BoxLayout:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: app.bg_app
        Rectangle:
            pos: self.pos
            size: self.size

    # cabeçalho — banner de fundo (BannerArt, ver banners.py) + avatar/nome.
    # Toque no avatar abre a tela de personalização de perfil. Ajustes é aba
    # da barra de baixo. Some durante splash/onboarding.
    FloatLayout:
        size_hint_y: None
        height: 0 if (app.current_screen,) and app.is_onboarding_screen() else (dp(64) if app.equipped_title else dp(52))
        opacity: 0 if (app.current_screen,) and app.is_onboarding_screen() else 1
        disabled: (app.current_screen,) and app.is_onboarding_screen()

        BannerArt:
            size_hint: None, None
            pos: self.parent.pos
            size: self.parent.size
            pattern: app.banner_pattern
            color: app.banner_color
            edge_divider: True
            # um tom mais escuro que o destaque do tema, e acompanha a troca de tema
            divider_color: app.accent[0] * 0.72, app.accent[1] * 0.72, app.accent[2] * 0.72, 1

        BoxLayout:
            size_hint: None, None
            pos: self.parent.pos
            size: self.parent.size
            padding: dp(12), dp(8)
            spacing: dp(10)

            TapArea:
                id: tut_avatar
                orientation: "horizontal"
                spacing: dp(6)
                on_release: app.open_profile_screen()

                BoxLayout:
                    size_hint: None, None
                    size: dp(32), dp(32)
                    canvas.before:
                        Color:
                            rgba: app.accent_soft
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(7)]

                    # Widget "burro" (sem layout próprio) só pra poder
                    # sobrepor foto e moldura livremente — BoxLayout nunca
                    # sobrepõe dois filhos, sempre bota cada um no seu
                    # próprio "slot" ao lado do outro (mesma solução que o
                    # BadgeCard já usa pra pose+moldura, ver <BadgeCard@...>).
                    # SEM padding aqui (era do BoxLayout antigo, só pra
                    # empurrar a foto): este Widget cobre o dp(32) INTEIRO —
                    # é a moldura equipada que precisa da área cheia, pra
                    # ficar bem em cima do "anel" desenhado acima
                    # (accent_soft), não só por cima da fotinho de dentro.
                    Widget:
                        Image:
                            source: (app.profile_avatar, app.profile_photo_path) and app.current_avatar_path()
                            # inset manual de dp(3) (era padding do BoxLayout
                            # antigo) — só a FOTO fica encolhida assim; a
                            # moldura, logo abaixo, cobre o Widget inteiro.
                            pos: self.parent.x + dp(3), self.parent.y + dp(3)
                            size: self.parent.width - dp(6), self.parent.height - dp(6)
                            allow_stretch: True
                            keep_ratio: True  # a foto enviada já vem quadrada (ImageOps.fit em _prepare_photo);
                            # as poses do Focum também são quadradas, então não distorce
                            # o Image em si é um RETÂNGULO reto — sem clipar, os 4 cantos dele
                            # apareciam por cima dos cantos arredondados do fundo. O stencil
                            # abaixo corta o desenho da foto na mesma forma arredondada.
                            canvas.before:
                                StencilPush
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]
                                StencilUse
                            canvas.after:
                                StencilUnUse
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]
                                StencilPop

                        # moldura decorativa equipada (Loja de Recompensas/
                        # marcos — ver mascot.FRAMES), arte de verdade por
                        # cima da foto (listada depois dela = desenha por
                        # cima). Cobre o Widget INTEIRO (dp(32), sem inset) —
                        # mesmo lugar de antes do anel colorido (Line
                        # desenhada com self.x/y/width/height do BoxLayout de
                        # fora, que padding nenhum encolhia). "" quando
                        # "none"/arquivo ausente colapsa o tamanho — source
                        # vazio pintaria retângulo branco (textura None +
                        # Color branco), não fica invisível sozinho (ver
                        # App.current_frame_path).
                        Image:
                            source: (app.profile_frame,) and app.current_frame_path()
                            # algumas molduras pedem um scale > 1.0 (ver
                            # mascot.FRAMES / App.current_frame_scale) — cresce
                            # centralizado, nunca só pra um lado
                            size: [s * ((app.profile_frame,) and app.current_frame_scale()) for s in self.parent.size] if ((app.profile_frame,) and app.current_frame_path()) else (0, 0)
                            pos: self.parent.center_x - self.width / 2, self.parent.center_y - self.height / 2
                            allow_stretch: True
                            keep_ratio: False

                BoxLayout:
                    orientation: "vertical"

                    Label:
                        text: app.account_name if app.has_account else "Discipliner"
                        font_name: TITLE_FONT
                        color: app.text_dark
                        bold: True
                        font_size: FS_TITLE
                        halign: "left"
                        valign: "middle" if not app.equipped_title else "bottom"
                        text_size: self.size
                        shorten: True

                    # título equipado (emblema escolhido em Emblemas > detalhes) —
                    # some quando nenhum está equipado, sem tirar espaço do nome
                    Label:
                        text: app.equipped_title and app.t(f"badge_{app.equipped_title}_name")
                        color: app.accent
                        bold: True
                        font_size: FS_CAPTION
                        size_hint_y: None
                        height: dp(14) if app.equipped_title else 0
                        halign: "left"
                        valign: "top"
                        text_size: self.size
                        shorten: True

                Label:
                    text: ">"
                    color: app.muted
                    bold: True
                    font_size: "14sp"
                    size_hint_x: None
                    width: dp(12)
                    valign: "middle"
                    text_size: self.size

    ScreenManager:
        id: screen_manager
        # slide curto (0.13s) no lugar dos 0.4s padrão. Causa de "os botões são
        # clicados mas raramente processam o clique": ScreenManager.on_touch_down
        # retorna False enquanto transition.is_active, então durante o slide todo
        # toque num botão da tela nova sumia sem feedback — 0.4s é uma janela
        # morta enorme depois de cada navegação (agora ~130ms, dentro do tempo
        # de reação de quem troca de aba e olha antes de tocar). NoTransition()
        # zeraria a janela de vez; mantido o slide curto por ser o caminho
        # testado do Kivy. Ver test_nav_taps.py.
        transition: SlideTransition(duration=0.13)

        Screen:
            name: "splash"
            canvas.before:
                Color:
                    rgba: app.bg_app
                Rectangle:
                    pos: self.pos
                    size: self.size

            # GIF animado do ícone (o presplash nativo continua PNG estático).
            # anim_loop 0 = loop enquanto o splash está na tela; corte ping-pong,
            # emenda sem pulo. anim_delay 0.1 = 10 fps (bate com o GIF); o padrão
            # do Kivy é 0.25 = 4 fps, travado.
            # pos explícito (não pos_hint): com pos_hint o Kivy tava ignorando o
            # `size` do Image e ele enchia a tela toda.
            Image:
                id: splash_icon
                source: "assets/focum/focum_intro.gif"
                anim_loop: 0
                anim_delay: 0.1
                size_hint: None, None
                size: dp(200), dp(200)
                pos: self.parent.center_x - self.width / 2, self.parent.center_y - self.height / 2 + dp(60)
                allow_stretch: True
                keep_ratio: True

            # título do splash: bem maior que FS_DISPLAY (28sp) e na cor de
            # destaque, com um "sombreado" barato — o mesmo texto atrás,
            # deslocado e escuro, dá profundidade sem precisar de fonte nova
            Label:
                text: "Discipliner"
                font_name: SPLASH_FONT
                color: 0, 0, 0, 0.35
                opacity: splash_icon.opacity
                font_size: "46sp"
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_x": 0.503, "center_y": 0.353}

            Label:
                text: "Discipliner"
                # Lilita One (embutida, ver main.SPLASH_FONT) — já é gorda,
                # sem negrito falso por cima
                font_name: SPLASH_FONT
                # entra e sai junto com o GIF (App._play_splash anima só o
                # splash_icon; o título copia a opacidade dele)
                opacity: splash_icon.opacity
                # sempre branco: a marca não muda com o tema de cor escolhido
                color: 1, 1, 1, 1
                font_size: "46sp"
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_x": 0.5, "center_y": 0.36}

        Screen:
            name: "missions"
            BoxLayout:
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(10)

                # atalhos em pílula (estilo Spotify) pras telas que não estão
                # na barra de baixo
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)

                    ChipButton:
                        text: app.language and (app.t('streaks_title'))
                        on_release: app.open_streaks_screen()

                    # substitui o antigo botão "Loja · N pontos" (mesma função,
                    # duplicado): os pontos continuam à vista aqui. O id é o
                    # alvo do passo "rewards" do tutorial (main.TUTORIAL_STEPS)
                    ChipButton:
                        id: tut_rewards_btn
                        text: (app.available_points,) and app.language and (app.t('btn_rewards_shop') + " · " + str(app.available_points))
                        on_release: app.switch_screen("rewards_shop")

                    ChipButton:
                        text: app.language and (app.t('chip_stats'))
                        on_release: app.open_advanced_stats()

                    Widget:

                BoxLayout:
                    size_hint_y: None
                    height: dp(60)
                    spacing: dp(12)

                    # só mostra os dias: quem leva pra tela de sequências é a
                    # pílula "Sequências" lá em cima (dois caminhos pro mesmo lugar)
                    ClayCard:
                        id: tut_streak_card
                        bg_color: app.accent_soft
                        orientation: "vertical"
                        padding: dp(8), dp(8), dp(8), dp(10)
                        Label:
                            # sequência do tipo da aba ativa (dias / semanas / meses)
                            text: app.language and (app.mission_view, app.streak, app.streak_semanal, app.streak_mensal) and ((str(app.streak) + " " + (app.t('streak_day') if app.streak == 1 else app.t('streak_days'))) if app.mission_view == "diaria" else (str(app.streak_for_tab(app.mission_view)) + " " + app.streak_unit_label(app.mission_view).capitalize()))
                            color: app.text_dark
                            bold: True
                            font_size: FS_HEADING
                        Label:
                            text: app.language and (app.t('streak_label'))
                            color: app.muted
                            font_size: FS_CAPTION

                    ClayCard:
                        id: tut_level_card
                        bg_color: app.accent_soft
                        orientation: "vertical"
                        padding: dp(8)
                        Label:
                            text: app.language and (app.t('level_prefix') + " " + str(app.level))
                            color: app.text_dark
                            bold: True
                            font_size: FS_HEADING
                        Label:
                            text: str(app.xp_in_level) + "/" + str(app.xp_for_next) + " XP"
                            color: app.muted
                            font_size: FS_CAPTION

                # cabeçalho clicável: recolhe a lista de recompensas de nível
                # pra sobrar tela pras missões (estado guardado em app_settings)
                TapArea:
                    size_hint_y: None
                    height: dp(26)
                    spacing: dp(6)
                    on_release: app.toggle_level_rewards()

                    # pos_hint centraliza no eixo transversal do BoxLayout — o
                    # FieldLabel tem altura própria (size_hint_y None) e sem
                    # isso ficaria colado embaixo da faixa clicável
                    SectionLabel:
                        text: app.language and (app.t('level_rewards_title')).upper()
                        valign: "middle"
                        pos_hint: {"center_y": 0.5}

                    # ">" girado, e não um triangulinho do bloco Geometric
                    # Shapes: a fonte padrão do Android (Roboto) não tem esses
                    # glifos e eles saíam como quadradinho vazio no aparelho.
                    # ">" é ASCII, está em qualquer fonte, e girar -90° faz
                    # apontar pra baixo. Ver test_theme.run_glyphs.
                    Label:
                        text: ">"
                        color: app.muted
                        bold: True
                        font_size: "12sp"
                        size_hint_x: None
                        width: dp(16)
                        halign: "center"
                        valign: "middle"
                        text_size: self.size
                        canvas.before:
                            PushMatrix
                            Rotate:
                                angle: -90 if app.level_rewards_open else 0
                                origin: self.center
                        canvas.after:
                            PopMatrix

                ScrollView:
                    size_hint_y: None
                    height: dp(120) if app.level_rewards_open else 0
                    opacity: 1 if app.level_rewards_open else 0
                    disabled: not app.level_rewards_open
                    do_scroll_y: False
                    GridLayout:
                        id: level_rewards_list
                        rows: 1
                        spacing: dp(8)
                        size_hint_x: None
                        width: self.minimum_width

                Label:
                    id: tut_freeze_label
                    text: (app.streak_freezes_left,) and app.language and app.freeze_status_text()
                    color: app.success if app.streak_freeze_available else app.muted
                    font_size: FS_CAPTION
                    size_hint_y: None
                    height: dp(16)

                # abas do tipo de missão: troca lista, progresso e sequência
                # pro tipo escolhido (App.set_mission_view). Linha separada dos
                # atalhos lá de cima de propósito
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)

                    ClayButton:
                        text: app.language and (app.t('chip_daily'))
                        bg_color: app.accent if app.mission_view == "diaria" else app.accent_soft
                        text_color: app.text_light if app.mission_view == "diaria" else app.text_dark
                        on_release: app.set_mission_view("diaria")

                    ClayButton:
                        text: app.language and (app.t('chip_weekly'))
                        bg_color: app.accent if app.mission_view == "semanal" else app.accent_soft
                        text_color: app.text_light if app.mission_view == "semanal" else app.text_dark
                        on_release: app.set_mission_view("semanal")

                    ClayButton:
                        text: app.language and (app.t('chip_monthly'))
                        bg_color: app.accent if app.mission_view == "mensal" else app.accent_soft
                        text_color: app.text_light if app.mission_view == "mensal" else app.text_dark
                        on_release: app.set_mission_view("mensal")

                ClayProgressBar:
                    id: tut_progress_bar
                    value: app.progress

                SectionLabel:
                    text: app.language and (app.t('progress_label') + " " + str(int(app.progress * 100)) + "%").upper()
                    height: dp(20)

                Label:
                    text: app.language and (app.t('missions_period_empty'))
                    color: app.muted
                    font_size: FS_CAPTION
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(30) if app.missions_empty else 0
                    opacity: 1 if app.missions_empty else 0

                ScrollView:
                    id: tut_missions_list
                    GridLayout:
                        id: missions_list
                        cols: 1
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height

                BoxLayout:
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)

                    ClayButton:
                        id: tut_add_mission
                        text: app.language and (app.t('add_mission_button'))
                        bg_color: app.accent
                        # já abre no tipo da aba ativa
                        on_release: app.open_add_popup(app.mission_view)

                    ClayButton:
                        id: tut_suggestions
                        text: app.language and (app.t('btn_suggestions'))
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        size_hint_x: None
                        width: dp(110)
                        on_release: app.open_suggestions_popup()

                    ClayButton:
                        text: app.language and (app.t('btn_challenges'))
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        size_hint_x: None
                        width: dp(100)
                        on_release: app.open_challenges_popup()

        Screen:
            name: "history"
            BoxLayout:
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(10)

                BoxLayout:
                    orientation: "vertical"
                    spacing: dp(10)
                    padding: dp(20), dp(20)
                    opacity: 1 if app.history_empty else 0
                    disabled: not app.history_empty
                    size_hint_y: None
                    # altura calculada pelo próprio conteúdo (nunca corta) em vez de
                    # um número fixo que já ficou pequeno demais pro conteúdo uma vez
                    height: self.minimum_height if app.history_empty else 0

                    Image:
                        source: app.sleeping_mascot_path()
                        allow_stretch: True
                        keep_ratio: True
                        size_hint_y: None
                        height: dp(130)

                    Label:
                        text: app.language and (app.t('history_empty_title'))
                        color: app.text_dark
                        bold: True
                        font_size: "16sp"
                        size_hint_y: None
                        height: dp(24)

                    Label:
                        text: app.language and (app.t('history_empty_message'))
                        color: app.muted
                        font_size: "12sp"
                        halign: "center"
                        valign: "top"
                        text_size: self.width, None
                        size_hint_y: None
                        height: dp(50)

                ScrollView:
                    GridLayout:
                        id: history_list
                        cols: 1
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

        Screen:
            name: "chart"
            # AnchorLayout + BoxLayout com altura própria (não a tela toda) —
            # só 1 dos 3 cartões de gráfico fica visível por vez (os outros
            # ficam com altura 0), então o conteúdo raramente enche a tela
            # inteira; sem isso, ele ficava "colado" no topo com um vão vazio
            # embaixo em vez de centralizado
            AnchorLayout:
                anchor_y: "center"
                BoxLayout:
                    orientation: "vertical"
                    size_hint: 1, None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(12)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(64)
                        spacing: dp(12)

                        ClayCard:
                            bg_color: app.accent_soft
                            orientation: "vertical"
                            padding: dp(8)
                            Label:
                                text: app.month_label
                                color: app.text_dark
                                bold: True
                                font_size: "13sp"
                            Label:
                                text: app.language and (app.t('chart_month_label'))
                                color: app.muted
                                font_size: "11sp"

                        ClayCard:
                            bg_color: app.accent_soft
                            orientation: "vertical"
                            padding: dp(8)
                            Label:
                                text: str(app.total_points)
                                color: app.text_dark
                                bold: True
                                font_size: "18sp"
                            Label:
                                text: app.language and (app.t('chart_points_label'))
                                color: app.muted
                                font_size: "11sp"

                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)

                        ClayButton:
                            text: app.language and (app.t('chart_type_heatmap'))
                            bg_color: app.accent if app.chart_type == "heatmap" else app.accent_soft
                            text_color: app.text_light if app.chart_type == "heatmap" else app.text_dark
                            on_release: app.set_chart_type("heatmap")

                        ClayButton:
                            text: app.language and (app.t('chart_type_bars'))
                            bg_color: app.accent if app.chart_type == "bars" else app.accent_soft
                            text_color: app.text_light if app.chart_type == "bars" else app.text_dark
                            on_release: app.set_chart_type("bars")

                        ClayButton:
                            text: app.language and (app.t('chart_type_lines'))
                            bg_color: app.accent if app.chart_type == "lines" else app.accent_soft
                            text_color: app.text_light if app.chart_type == "lines" else app.text_dark
                            on_release: app.set_chart_type("lines")

                    ClayCard:
                        bg_color: app.bg_card_soft
                        padding: dp(14)
                        size_hint_y: None
                        height: dp(320) if app.chart_type == "heatmap" else 0
                        opacity: 1 if app.chart_type == "heatmap" else 0
                        disabled: app.chart_type != "heatmap"
                        HeatmapCalendar:
                            id: heatmap_calendar
                            base_color: app.bg_card
                            accent_color: app.accent
                            text_dark: app.text_dark

                    ClayCard:
                        bg_color: app.bg_card_soft
                        padding: dp(14)
                        size_hint_y: None
                        height: dp(320) if app.chart_type == "bars" else 0
                        opacity: 1 if app.chart_type == "bars" else 0
                        disabled: app.chart_type != "bars"
                        BarChart:
                            id: bar_chart
                            grid_color: app.bg_card
                            accent_color: app.accent
                            text_dark: app.text_dark

                    ClayCard:
                        bg_color: app.bg_card_soft
                        padding: dp(14)
                        size_hint_y: None
                        height: dp(320) if app.chart_type == "lines" else 0
                        opacity: 1 if app.chart_type == "lines" else 0
                        disabled: app.chart_type != "lines"
                        LineChart:
                            id: line_chart
                            grid_color: app.bg_card
                            accent_color: app.accent
                            text_dark: app.text_dark

                    ClayButton:
                        text: app.language and (app.t('chart_refresh_button'))
                        bg_color: app.accent
                        size_hint_y: None
                        height: dp(48)
                        on_release: app.refresh_chart()

        Screen:
            name: "rewards_shop"
            BoxLayout:
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(10)

                Label:
                    text: app.language and (app.t('rewards_shop_title'))
                    color: app.text_dark
                    bold: True
                    font_size: "20sp"
                    size_hint_y: None
                    height: dp(30)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                ClayCard:
                    bg_color: app.accent_soft
                    orientation: "vertical"
                    padding: dp(10)
                    size_hint_y: None
                    height: dp(56)

                    Label:
                        text: str(app.available_points)
                        color: app.text_dark
                        bold: True
                        font_size: "20sp"
                    Label:
                        text: app.language and (app.t('rewards_available_points'))
                        color: app.muted
                        font_size: "11sp"

                ClayButton:
                    text: app.language and ("+ " + app.t('reward_form_new_title'))
                    bg_color: app.accent
                    size_hint_y: None
                    height: dp(44)
                    on_release: app.open_add_reward_popup()

                Label:
                    text: app.language and (app.t('rewards_empty_note'))
                    color: app.muted
                    font_size: "12sp"
                    halign: "center"
                    valign: "middle"
                    text_size: self.width, None
                    size_hint_y: None
                    height: (self.texture_size[1] + dp(8)) if not rewards_list.children else 0

                ScrollView:
                    size_hint_y: None
                    height: self.parent.height * 0.4
                    GridLayout:
                        id: rewards_list
                        cols: 1
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                FieldLabel:
                    text: app.language and (app.t('reward_history_title'))

                ScrollView:
                    GridLayout:
                        id: reward_history_list
                        cols: 1
                        spacing: dp(6)
                        size_hint_y: None
                        height: self.minimum_height

        Screen:
            name: "badges"
            BoxLayout:
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(10)

                Label:
                    text: app.language and (app.t('badges_title'))
                    color: app.text_dark
                    bold: True
                    font_size: "20sp"
                    size_hint_y: None
                    height: dp(30)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                ScrollView:
                    GridLayout:
                        id: badges_list
                        cols: 2
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

        # personalização de perfil — abre ao tocar no avatar do cabeçalho
        # (app.open_profile_screen). Sem aba na barra: volta pelo "<" ou pelo
        # botão voltar do Android. As 4 listas são montadas por
        # main._build_profile_pickers ao entrar na tela.
        Screen:
            name: "profile"
            ScrollView:
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(14)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(38)
                        spacing: dp(8)

                        ClayButton:
                            text: "<"
                            bg_color: app.bg_card
                            text_color: app.text_dark
                            size_hint_x: None
                            width: dp(44)
                            on_release: app.switch_screen("missions")

                        Label:
                            text: app.language and (app.t('profile_title'))
                            color: app.text_dark
                            bold: True
                            font_size: FS_TITLE
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                    # ---- BANNER ----
                    SectionLabel:
                        text: app.language and (app.t('banner_label')).upper()

                    # grade 3 col: alvos de toque grandes (dp96x52). Era uma
                    # linha só de miniaturas dp48x34 — pequenas demais, "os
                    # botões do banner clicam raramente".
                    GridLayout:
                        id: prof_banner_list
                        cols: 3
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)
                        padding: 0, dp(2)

                    ClayButton:
                        text: app.language and (app.t('banner_custom_label'))
                        bg_color: app.accent if (app.is_premium and app.profile_banner == "custom") else app.bg_card
                        text_color: app.text_light if (app.is_premium and app.profile_banner == "custom") else app.muted
                        disabled: not app.is_premium
                        size_hint_y: None
                        height: dp(40)
                        on_release: app.set_profile_banner("custom")

                    Label:
                        text: app.language and (app.t('premium_locked_note'))
                        color: app.muted
                        font_size: FS_CAPTION
                        size_hint_y: None
                        height: dp(24) if not app.is_premium else 0
                        opacity: 1 if not app.is_premium else 0
                        halign: "left"
                        valign: "top"
                        text_size: self.width, None

                    # painel do banner personalizado — some quando não é Premium
                    # ou o banner escolhido não é "custom". CADA filho de altura
                    # fixa também zera quando escondido: senão o Kivy mantém
                    # AnchorLayout/roda com a altura antiga por cima da grade de
                    # banners e a roda engole o toque nos thumbs ("os botões do
                    # banner clicam raramente"). Mesmo bug já visto no avatar_list.
                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(6) if (app.is_premium and app.profile_banner == "custom") else 0
                        size_hint_y: None
                        height: self.minimum_height if (app.is_premium and app.profile_banner == "custom") else 0
                        opacity: 1 if (app.is_premium and app.profile_banner == "custom") else 0
                        disabled: not (app.is_premium and app.profile_banner == "custom")

                        AnchorLayout:
                            size_hint_y: None
                            height: dp(190) if (app.is_premium and app.profile_banner == "custom") else 0

                            AccentColorWheel:
                                size_hint: None, None
                                size: (dp(180), dp(180)) if (app.is_premium and app.profile_banner == "custom") else (0, 0)
                                hue: app.custom_banner_hue
                                sat: app.custom_banner_sat
                                on_pick: app.pick_custom_banner(args[1], args[2])

                        FieldLabel:
                            text: app.language and (app.t('banner_pattern_label'))
                            height: (max(dp(18), self.texture_size[1])) if (app.is_premium and app.profile_banner == "custom") else 0

                        GridLayout:
                            cols: 3
                            spacing: dp(6)
                            size_hint_y: None
                            height: self.minimum_height if (app.is_premium and app.profile_banner == "custom") else 0

                            ClayButton:
                                text: app.language and (app.t('pattern_solid'))
                                bg_color: app.accent if app.custom_banner_pattern == "solid" else app.bg_card
                                text_color: app.text_light if app.custom_banner_pattern == "solid" else app.text_dark
                                size_hint_y: None
                                height: dp(38)
                                on_release: app.set_custom_banner_pattern("solid")
                            ClayButton:
                                text: app.language and (app.t('pattern_gradient'))
                                bg_color: app.accent if app.custom_banner_pattern == "gradient" else app.bg_card
                                text_color: app.text_light if app.custom_banner_pattern == "gradient" else app.text_dark
                                size_hint_y: None
                                height: dp(38)
                                on_release: app.set_custom_banner_pattern("gradient")
                            ClayButton:
                                text: app.language and (app.t('pattern_stripes'))
                                bg_color: app.accent if app.custom_banner_pattern == "stripes" else app.bg_card
                                text_color: app.text_light if app.custom_banner_pattern == "stripes" else app.text_dark
                                size_hint_y: None
                                height: dp(38)
                                on_release: app.set_custom_banner_pattern("stripes")
                            ClayButton:
                                text: app.language and (app.t('pattern_dots'))
                                bg_color: app.accent if app.custom_banner_pattern == "dots" else app.bg_card
                                text_color: app.text_light if app.custom_banner_pattern == "dots" else app.text_dark
                                size_hint_y: None
                                height: dp(38)
                                on_release: app.set_custom_banner_pattern("dots")
                            ClayButton:
                                text: app.language and (app.t('pattern_grid'))
                                bg_color: app.accent if app.custom_banner_pattern == "grid" else app.bg_card
                                text_color: app.text_light if app.custom_banner_pattern == "grid" else app.text_dark
                                size_hint_y: None
                                height: dp(38)
                                on_release: app.set_custom_banner_pattern("grid")
                            ClayButton:
                                text: app.language and (app.t('pattern_chevron'))
                                bg_color: app.accent if app.custom_banner_pattern == "chevron" else app.bg_card
                                text_color: app.text_light if app.custom_banner_pattern == "chevron" else app.text_dark
                                size_hint_y: None
                                height: dp(38)
                                on_release: app.set_custom_banner_pattern("chevron")

                    # ---- FOTO DE PERFIL ----
                    SectionLabel:
                        text: app.language and (app.t('avatar_label')).upper()

                    ClayButton:
                        text: app.language and (app.t('upload_photo_label'))
                        bg_color: app.accent if app.is_premium else app.bg_card
                        text_color: app.text_light if app.is_premium else app.muted
                        disabled: not app.is_premium
                        size_hint_y: None
                        height: dp(42)
                        on_release: app.upload_profile_photo()

                    Label:
                        text: app.language and app.photo_formats_text()
                        color: app.muted
                        font_size: "9sp"
                        size_hint_y: None
                        height: dp(13)
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None

                    Label:
                        text: app.photo_status
                        color: app.danger
                        font_size: FS_CAPTION
                        size_hint_y: None
                        height: dp(24) if app.photo_status else 0
                        opacity: 1 if app.photo_status else 0
                        halign: "left"
                        valign: "top"
                        text_size: self.width, None

                    GridLayout:
                        id: prof_avatar_list
                        cols: 4
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height

                    # ---- MOLDURA ----
                    SectionLabel:
                        text: app.language and (app.t('frame_label')).upper()

                    BoxLayout:
                        id: prof_frame_list
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)

                    # ---- ÍCONE DO APP ----
                    SectionLabel:
                        text: app.language and (app.t('app_icon_label')).upper()

                    BoxLayout:
                        id: prof_icon_list
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)

        Screen:
            name: "streaks"
            ScrollView:
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(12)

                    Label:
                        text: app.language and (app.t('streaks_title'))
                        color: app.text_dark
                        bold: True
                        font_size: "20sp"
                        size_hint_y: None
                        height: dp(30)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
    
                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)
    
                        ClayButton:
                            text: app.language and (app.periodicity_tab_label("diaria"))
                            bg_color: app.accent if app.streak_tab == "diaria" else app.accent_soft
                            text_color: app.text_light if app.streak_tab == "diaria" else app.text_dark
                            on_release: app.switch_streak_tab("diaria")
    
                        ClayButton:
                            text: app.language and (app.periodicity_tab_label("semanal"))
                            bg_color: app.accent if app.streak_tab == "semanal" else app.accent_soft
                            text_color: app.text_light if app.streak_tab == "semanal" else app.text_dark
                            on_release: app.switch_streak_tab("semanal")
    
                        ClayButton:
                            text: app.language and (app.periodicity_tab_label("mensal"))
                            bg_color: app.accent if app.streak_tab == "mensal" else app.accent_soft
                            text_color: app.text_light if app.streak_tab == "mensal" else app.text_dark
                            on_release: app.switch_streak_tab("mensal")
    
                    ClayCard:
                        bg_color: app.accent_soft
                        orientation: "vertical"
                        padding: dp(18)
                        spacing: dp(4)
                        size_hint_y: None
                        height: dp(120)
    
                        Label:
                            text: app.language and (app.t('streak_current_label'))
                            color: app.text_dark
                            bold: True
                            font_size: "12sp"
                            size_hint_y: None
                            height: dp(18)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
    
                        Label:
                            text: app.language and (app.streak, app.streak_semanal, app.streak_mensal) and (str(app.streak_for_tab(app.streak_tab)) + " " + app.streak_unit_label(app.streak_tab))
                            color: app.text_dark
                            bold: True
                            font_size: "34sp"
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
    
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(4)
                        size_hint_y: None
                        height: self.minimum_height
    
                        FieldLabel:
                            text: app.language and (app.t('streak_multiplier_label'))
    
                        Label:
                            text: app.language and (app.streak, app.streak_semanal, app.streak_mensal) and (str(app.streak_multiplier_for_tab(app.streak_tab)) + "x")
                            color: app.accent
                            bold: True
                            font_size: "22sp"
                            size_hint_y: None
                            height: dp(30)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
    
                        Label:
                            text: app.language and (app.streak, app.streak_semanal, app.streak_mensal) and (app.streak_next_tier_text(app.streak_tab))
                            color: app.muted
                            font_size: "11sp"
                            size_hint_y: None
                            height: dp(18)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        # bônus PERMANENTE (ver missions.permanent_bonus) — some
                        # (height 0) sem nenhum marco batido ainda, ao contrário
                        # da linha de cima que sempre mostra algo
                        Label:
                            text: app.language and (app.permanent_bonus_pct,) and (app.permanent_bonus_text())
                            color: app.success
                            bold: True
                            font_size: "11sp"
                            size_hint_y: None
                            height: dp(18) if app.permanent_bonus_pct else 0
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "horizontal"
                        padding: dp(14)
                        size_hint_y: None
                        height: dp(56)
    
                        Label:
                            text: app.language and (app.t('streak_best_label'))
                            color: app.muted
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
    
                        Label:
                            text: app.language and (app.best_streak, app.best_streak_semanal, app.best_streak_mensal) and (str(app.best_streak_for_tab(app.streak_tab)) + " " + app.streak_unit_label(app.streak_tab))
                            color: app.text_dark
                            bold: True
                            halign: "right"
                            valign: "middle"
                            text_size: self.size
    
                    Label:
                        text: app.language and (app.t('streak_freeze_note_short'))
                        color: app.muted
                        font_size: "10sp"
                        halign: "center"
                        valign: "top"
                        text_size: self.width, None
                        size_hint_y: None
                        height: dp(30) if app.streak_tab == "diaria" else 0
                        opacity: 1 if app.streak_tab == "diaria" else 0

                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "horizontal"
                        padding: dp(12)
                        spacing: dp(4)
                        size_hint_y: None
                        height: dp(56)

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: app.language and (app.t('weekly_summary_title'))
                                color: app.muted
                                font_size: "10sp"
                                bold: True
                                halign: "left"
                                valign: "top"
                                text_size: self.size
                            Label:
                                text: (app.language and (str(app.weekly_points) + " " + app.points_word(app.weekly_points) + " " + app.t('weekly_points_label')))
                                color: app.text_dark
                                bold: True
                                font_size: "15sp"
                                halign: "left"
                                valign: "bottom"
                                text_size: self.size

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(84)
                            Label:
                                text: ("+" if app.weekly_change_pct >= 0 else "") + str(app.weekly_change_pct) + "%"
                                color: app.success if app.weekly_change_pct >= 0 else app.danger
                                bold: True
                                font_size: "15sp"
                            Label:
                                text: app.language and (app.t('weekly_vs_last'))
                                color: app.muted
                                font_size: "9sp"

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(64)
                            Label:
                                text: app.weekly_best_day if app.weekly_best_day else "—"
                                color: app.text_dark
                                bold: True
                                font_size: "15sp"
                            Label:
                                text: app.language and (app.t('weekly_best_day_label'))
                                color: app.muted
                                font_size: "9sp"

                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "horizontal"
                        padding: dp(12)
                        spacing: dp(4)
                        size_hint_y: None
                        height: dp(56)

                        BoxLayout:
                            orientation: "vertical"
                            Label:
                                text: app.language and (app.t('monthly_summary_title'))
                                color: app.muted
                                font_size: "10sp"
                                bold: True
                                halign: "left"
                                valign: "top"
                                text_size: self.size
                            Label:
                                text: (app.language and (str(app.monthly_points) + " " + app.points_word(app.monthly_points) + " " + app.t('monthly_points_label')))
                                color: app.text_dark
                                bold: True
                                font_size: "15sp"
                                halign: "left"
                                valign: "bottom"
                                text_size: self.size

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(84)
                            Label:
                                text: ("+" if app.monthly_change_pct >= 0 else "") + str(app.monthly_change_pct) + "%"
                                color: app.success if app.monthly_change_pct >= 0 else app.danger
                                bold: True
                                font_size: "15sp"
                            Label:
                                text: app.language and (app.t('monthly_vs_last'))
                                color: app.muted
                                font_size: "9sp"

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(64)
                            Label:
                                text: app.monthly_best_day if app.monthly_best_day else "—"
                                color: app.text_dark
                                bold: True
                                font_size: "15sp"
                            Label:
                                text: app.language and (app.t('monthly_best_day_label'))
                                color: app.muted
                                font_size: "9sp"

                    ClayButton:
                        text: app.language and (app.t('btn_advanced_stats'))
                        bg_color: app.bg_card_soft
                        text_color: app.text_dark
                        size_hint_y: None
                        height: dp(44)
                        on_release: app.open_advanced_stats()

                    ClayButton:
                        text: app.language and (app.t('btn_share_streak'))
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        size_hint_y: None
                        height: dp(44)
                        on_release: app.share_streak_card()

                    Label:
                        text: app.share_status
                        color: app.success
                        bold: True
                        font_size: "11sp"
                        size_hint_y: None
                        height: dp(16) if app.share_status else 0

        Screen:
            name: "advanced_stats"
            ScrollView:
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(10)

                    Label:
                        text: app.language and (app.t('advanced_stats_title'))
                        color: app.text_dark
                        bold: True
                        font_size: "20sp"
                        size_hint_y: None
                        height: dp(30)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    # não é premium: teaser no lugar do conteúdo real
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(16)
                        spacing: dp(6)
                        size_hint_y: None
                        height: self.minimum_height if not app.is_premium else 0
                        opacity: 1 if not app.is_premium else 0
                        disabled: app.is_premium

                        Label:
                            text: app.language and (app.t('advanced_stats_locked_note'))
                            color: app.muted
                            font_size: "12sp"
                            halign: "center"
                            valign: "top"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]

                        ClayButton:
                            text: app.language and (app.t('btn_go_to_settings'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.switch_screen("settings")

                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height if app.is_premium else 0
                        opacity: 1 if app.is_premium else 0
                        disabled: not app.is_premium

                        HistorySectionLabel:
                            text: app.language and (app.t('stats_best_weekday_title'))

                        ClayCard:
                            bg_color: app.accent_soft
                            orientation: "vertical"
                            padding: dp(16)
                            size_hint_y: None
                            height: dp(70)

                            Label:
                                text: app.stats_best_weekday if app.stats_best_weekday else "—"
                                color: app.text_dark
                                bold: True
                                font_size: "22sp"
                                halign: "left"
                                valign: "middle"
                                text_size: self.size

                            Label:
                                text: (str(app.stats_best_weekday_points) + " " + app.t('chart_points_label')) if app.stats_best_weekday else ""
                                color: app.muted
                                font_size: "11sp"
                                halign: "left"
                                valign: "middle"
                                text_size: self.size

                        HistorySectionLabel:
                            text: app.language and (app.t('stats_months_title'))

                        BoxLayout:
                            id: months_stats_list
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(4)

                        HistorySectionLabel:
                            text: app.language and (app.t('stats_missions_title'))

                        BoxLayout:
                            id: missions_stats_list
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(4)

        Screen:
            name: "settings"
            ScrollView:
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(14)

                    Label:
                        text: app.language and (app.t('settings_title'))
                        color: app.text_dark
                        bold: True
                        font_size: "20sp"
                        size_hint_y: None
                        height: dp(30)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ClayButton:
                        text: app.language and (app.t('btn_review_tutorial'))
                        bg_color: app.accent_soft
                        text_color: app.text_dark
                        size_hint_y: None
                        height: dp(42)
                        on_release: app.tutorial_start()

                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        FieldLabel:
                            text: app.language and (app.t('field_language'))

                        ClaySpinner:
                            id: language_spinner
                            text: app.language_label()
                            values: app.language_values()
                            size_hint_y: None
                            height: dp(42)
                            on_text: app.set_language_from_label(self.text)

                        FieldLabel:
                            text: app.language and (app.t('appearance_label'))

                        ClayButton:
                            text: app.language and (app.t('label_switch_to_light') if app.dark_mode else app.t('label_switch_to_dark'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.toggle_dark_mode()

                        FieldLabel:
                            text: app.language and (app.t('theme_label'))

                        BoxLayout:
                            size_hint_y: None
                            height: dp(42)
                            spacing: dp(6)

                            ClayButton:
                                text: ("[ " + app.t('theme_coral') + " ]") if app.accent_theme == "coral" else app.t('theme_coral')
                                bg_color: 0.95, 0.55, 0.30, 1
                                text_color: app.text_light
                                on_release: app.set_accent_theme("coral")

                            ClayButton:
                                text: ("[ " + app.t('theme_oceano') + " ]") if app.accent_theme == "oceano" else app.t('theme_oceano')
                                bg_color: 0.20, 0.55, 0.75, 1
                                text_color: app.text_light
                                on_release: app.set_accent_theme("oceano")

                        BoxLayout:
                            size_hint_y: None
                            height: dp(42)
                            spacing: dp(6)

                            ClayButton:
                                text: ("[ " + app.t('theme_floresta') + " ]") if app.accent_theme == "floresta" else app.t('theme_floresta')
                                bg_color: 0.30, 0.62, 0.42, 1
                                text_color: app.text_light
                                on_release: app.set_accent_theme("floresta")

                            ClayButton:
                                text: ("[ " + app.t('theme_ameixa') + " ]") if app.accent_theme == "ameixa" else app.t('theme_ameixa')
                                bg_color: 0.58, 0.36, 0.68, 1
                                text_color: app.text_light
                                on_release: app.set_accent_theme("ameixa")

                        BoxLayout:
                            size_hint_y: None
                            height: dp(42)
                            spacing: dp(6)

                            ClayButton:
                                text: (app.custom_accent_hue,) and (("[ " + app.t('theme_custom') + " ]") if app.accent_theme == "custom" else app.t('theme_custom'))
                                bg_color: (app.custom_accent_hue, app.custom_accent_sat) and app.custom_accent_preview()
                                text_color: app.text_light
                                disabled: not app.is_premium
                                on_release: app.set_accent_theme("custom")

                        BoxLayout:
                            orientation: "vertical"
                            spacing: dp(4)
                            size_hint_y: None
                            height: self.minimum_height if (app.is_premium and app.accent_theme == "custom") else 0
                            opacity: 1 if (app.is_premium and app.accent_theme == "custom") else 0
                            disabled: not (app.is_premium and app.accent_theme == "custom")

                            # roda HSV no lugar dos dois sliders: ângulo = matiz,
                            # raio = saturação (ver widgets.ColorWheel). Mesmos
                            # dois valores de antes, num controle só.
                            FieldLabel:
                                text: app.language and (app.t('custom_color_label'))

                            # colapsa junto com a seção. O size da roda é FIXO:
                            # sem zerar aqui, a caixa dela continuava com
                            # 190dp mesmo com a seção em height 0, cobrindo os
                            # botões de tema logo acima e engolindo o toque.
                            AnchorLayout:
                                size_hint_y: None
                                height: dp(200) if (app.is_premium and app.accent_theme == "custom") else 0

                                AccentColorWheel:
                                    id: color_wheel
                                    size_hint: None, None
                                    size: (dp(190), dp(190)) if (app.is_premium and app.accent_theme == "custom") else (0, 0)
                                    hue: app.custom_accent_hue
                                    sat: app.custom_accent_sat
                                    on_pick: app.pick_custom_accent(args[1], args[2])

                    # aviso: notificações desligadas no sistema -> os lembretes
                    # não aparecem. Some (altura 0) quando está tudo certo.
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14) if app.notifications_blocked else 0
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height if app.notifications_blocked else 0
                        opacity: 1 if app.notifications_blocked else 0
                        disabled: not app.notifications_blocked

                        Label:
                            text: app.language and (app.t('notif_blocked_title'))
                            color: app.danger
                            bold: True
                            font_size: FS_LABEL
                            size_hint_y: None
                            height: self.texture_size[1] if app.notifications_blocked else 0
                            halign: "left"
                            valign: "top"
                            text_size: self.width, None

                        Label:
                            text: app.language and (app.t('notif_blocked_body'))
                            color: app.text_dark
                            font_size: FS_CAPTION
                            size_hint_y: None
                            height: self.texture_size[1] if app.notifications_blocked else 0
                            halign: "left"
                            valign: "top"
                            text_size: self.width, None

                        ClayButton:
                            text: app.language and (app.t('notif_blocked_button'))
                            bg_color: app.accent
                            size_hint_y: None
                            height: dp(42) if app.notifications_blocked else 0
                            on_release: app.open_notification_settings()

                    ClayCard:
                        id: tut_reminder_card
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        FieldLabel:
                            text: app.language and (app.t('reminder_label'))

                        ClayButton:
                            text: app.language and (app.t('reminder_enable'))
                            bg_color: app.accent if app.reminder_enabled else app.accent_soft
                            text_color: app.text_light if app.reminder_enabled else app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.toggle_reminder_enabled()

                        FieldLabel:
                            text: app.language and (app.t('reminder_time_label'))

                        ClayButton:
                            text: app.reminder_time
                            bg_color: app.bg_card
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.escolher_horario_lembrete()

                    # Ciclo pessoal — pra quem tem escala de trabalho rotativa
                    # (12x36, 24x48...) e o dia de folga não é sempre o mesmo
                    # dia da semana. Opt-in, 100% desligado por padrão. Ver
                    # missions._cycle_off_today e o spec em
                    # docs/superpowers/specs/2026-08-28-ciclo-pessoal-design.md
                    ClayCard:
                        id: tut_cycle_card
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        FieldLabel:
                            text: app.language and (app.t('work_cycle_label'))

                        Label:
                            text: app.language and (app.t('work_cycle_hint'))
                            color: app.muted
                            font_size: "11sp"
                            halign: "left"
                            valign: "top"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                        Widget:
                            size_hint_y: None
                            height: dp(6)

                        ClayButton:
                            text: app.language and (app.t('work_cycle_enable_on') if app.cycle_enabled else app.t('work_cycle_enable_off'))
                            bg_color: app.accent if app.cycle_enabled else app.accent_soft
                            text_color: app.text_light if app.cycle_enabled else app.text_dark
                            size_hint_x: 1 if app.cycle_enabled else 0.7
                            pos_hint: {} if app.cycle_enabled else {"center_x": 0.5}
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.toggle_work_cycle_enabled()

                        # tudo que só faz sentido com o ciclo ligado vai num
                        # container SÓ — colapsar cada filho individualmente
                        # (como era antes) não bastava: o "spacing" do
                        # BoxLayout de fora soma entre TODO filho, altura 0
                        # ou não, e com 7 filhos escondidos isso sozinho já
                        # virava um espaço morto enorme embaixo do botão
                        BoxLayout:
                            id: cycle_config_group
                            orientation: "vertical"
                            spacing: dp(8)
                            size_hint_y: None
                            height: self.minimum_height if app.cycle_enabled else 0
                            opacity: 1 if app.cycle_enabled else 0
                            disabled: not app.cycle_enabled

                            # cada filho AQUI DENTRO também condiciona a própria
                            # altura em app.cycle_enabled — o pai colapsado
                            # (acima) não é garantia de que um filho com altura
                            # PRÓPRIA fixa também colapse; sem isso ele fica
                            # invisível mas ainda ocupando espaço e recebendo
                            # toque (mesmo bug de "widget fantasma" já visto
                            # nos cards de conta/login, ver ui.kv histórico)
                            BoxLayout:
                                size_hint_y: None
                                height: dp(38) if app.cycle_enabled else 0
                                spacing: dp(6)

                                ClayButton:
                                    text: app.language and (app.t('work_cycle_preset_12x36'))
                                    bg_color: app.accent_soft
                                    text_color: app.text_dark
                                    disabled: not app.cycle_enabled
                                    on_release: app.apply_cycle_preset('12x36')

                                ClayButton:
                                    text: app.language and (app.t('work_cycle_preset_24x48'))
                                    bg_color: app.accent_soft
                                    text_color: app.text_dark
                                    disabled: not app.cycle_enabled
                                    on_release: app.apply_cycle_preset('24x48')

                                ClayButton:
                                    text: app.language and (app.t('work_cycle_preset_custom'))
                                    bg_color: app.accent_soft
                                    text_color: app.text_dark
                                    disabled: not app.cycle_enabled
                                    on_release: app.apply_cycle_preset('custom')

                            # Label puro, não FieldLabel: o FieldLabel tem uma
                            # altura própria (max(dp(18), texture_size)) fixada
                            # na CLASSE, que vence qualquer tentativa de
                            # sobrescrever "height:" numa instância — a label
                            # nunca colapsava de verdade, mesmo "escondida"
                            # (confirmado com teste isolado). Plain Label não
                            # tem esse conflito.
                            Label:
                                text: app.language and (app.t('work_cycle_length_label'))
                                color: app.muted
                                bold: True
                                font_size: "12sp"
                                halign: "left"
                                valign: "middle"
                                text_size: self.width, None
                                size_hint_y: None
                                height: dp(18) if app.cycle_enabled else 0

                            ClaySpinner:
                                id: cycle_length_spinner
                                text: str(app.cycle_length)
                                values: app.cycle_length_values()
                                size_hint_y: None
                                height: dp(42) if app.cycle_enabled else 0
                                disabled: not app.cycle_enabled
                                on_text: app.set_cycle_length(self.text)

                            Label:
                                text: app.language and (app.t('work_cycle_off_days_label'))
                                color: app.muted
                                bold: True
                                font_size: "12sp"
                                halign: "left"
                                valign: "middle"
                                text_size: self.width, None
                                size_hint_y: None
                                height: dp(18) if app.cycle_enabled else 0

                            BoxLayout:
                                id: cycle_day_toggles
                                size_hint_y: None
                                height: dp(34) if app.cycle_enabled else 0
                                disabled: not app.cycle_enabled
                                spacing: dp(4)

                            Label:
                                text: app.language and (app.t('work_cycle_today_label'))
                                color: app.muted
                                bold: True
                                font_size: "12sp"
                                halign: "left"
                                valign: "middle"
                                text_size: self.width, None
                                size_hint_y: None
                                height: dp(18) if app.cycle_enabled else 0

                            ClaySpinner:
                                id: cycle_today_spinner
                                text: "1"
                                values: ["1"]
                                size_hint_y: None
                                height: dp(42) if app.cycle_enabled else 0
                                disabled: not app.cycle_enabled
                                on_text: app.set_cycle_today(self.text)

                    # Premium — compra única de US$ 3 (ver README > Monetização).
                    # Sem checkbox de compra falso: o botão fica visível mas
                    # desabilitado até o Play Billing estar integrado de
                    # verdade (mesma postura do botão do Google mais abaixo).
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(6)
                        size_hint_y: None
                        height: self.minimum_height

                        Label:
                            text: app.language and (app.t('premium_active_title') if app.is_premium else app.t('premium_title'))
                            color: app.accent if app.is_premium else app.text_dark
                            bold: True
                            font_size: "14sp"
                            size_hint_y: None
                            height: dp(22)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        Label:
                            text: app.language and (app.t('premium_perks_note'))
                            color: app.muted
                            font_size: "11sp"
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"
                            text_size: self.width, None

                        # 2 formas de pagamento, 2 provedores diferentes —
                        # cartão vai pro Payment Link do Stripe (navegador),
                        # Pix gera um QR code na hora via Mercado Pago (a
                        # conta Stripe deste projeto não tem Pix liberado)
                        BoxLayout:
                            size_hint_y: None
                            height: dp(42) if not app.is_premium else 0
                            opacity: 1 if not app.is_premium else 0
                            spacing: dp(8)

                            ClayButton:
                                text: app.language and (app.t('btn_buy_premium_usd'))
                                bg_color: app.accent if app.has_account else app.bg_card
                                text_color: app.text_light if app.has_account else app.muted
                                disabled: not app.has_account
                                on_release: app.buy_premium()

                            ClayButton:
                                text: app.language and (app.t('btn_buy_premium_pix'))
                                bg_color: app.accent if app.has_account else app.bg_card
                                text_color: app.text_light if app.has_account else app.muted
                                disabled: not app.has_account
                                on_release: app.buy_premium_pix()

                        Label:
                            text: app.pix_error
                            color: app.danger
                            font_size: "10sp"
                            halign: "center"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: (self.texture_size[1] + dp(4)) if app.pix_error else 0

                        # pagou no navegador e o Premium não ligou sozinho? o
                        # webhook confirma no backend; isto só re-lê o resultado
                        ClayButton:
                            text: app.language and (app.t('btn_check_premium'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(38) if (app.has_account and not app.is_premium) else 0
                            opacity: 1 if (app.has_account and not app.is_premium) else 0
                            disabled: not (app.has_account and not app.is_premium)
                            on_release: app.check_premium_now()

                        Label:
                            text: app.language and (app.t('premium_login_required_note') if not app.has_account else app.t('premium_checkout_note'))
                            color: app.muted
                            font_size: "10sp"
                            size_hint_y: None
                            height: dp(28) if not app.is_premium else 0
                            opacity: 1 if not app.is_premium else 0
                            halign: "center"
                            valign: "top"
                            text_size: self.width, None

                    # Modo Sem Penalidade — um dos benefícios do Premium acima,
                    # com card próprio porque é um toggle (liga/desliga), não
                    # algo automático como os outros benefícios
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(4)
                        size_hint_y: None
                        height: self.minimum_height

                        Label:
                            text: app.language and (app.t('no_penalty_title'))
                            color: app.muted
                            bold: True
                            font_size: "13sp"
                            size_hint_y: None
                            height: dp(20)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        Label:
                            text: app.language and (app.t('no_penalty_desc'))
                            color: app.muted
                            font_size: "11sp"
                            size_hint_y: None
                            height: dp(30)
                            halign: "left"
                            valign: "top"
                            text_size: self.width, None

                        ClayButton:
                            text: app.language and (app.no_penalty_mode,) and (app.t('no_penalty_on') if app.no_penalty_mode else app.t('no_penalty_off')) if app.is_premium else app.t('no_penalty_title')
                            bg_color: (app.accent if app.no_penalty_mode else app.bg_card) if app.is_premium else app.bg_card
                            text_color: (app.text_light if app.no_penalty_mode else app.text_dark) if app.is_premium else app.muted
                            disabled: not app.is_premium
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.toggle_no_penalty_mode()

                        Label:
                            text: app.language and (app.t('premium_locked_note'))
                            color: app.muted
                            font_size: "10sp"
                            size_hint_y: None
                            height: dp(28) if not app.is_premium else 0
                            opacity: 1 if not app.is_premium else 0
                            halign: "center"
                            valign: "top"
                            text_size: self.width, None

                    # sem sessão: formulário de cadastro ou login (account_mode)
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(16)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height if (not app.has_account and not app.account_awaiting_confirmation) else 0
                        opacity: 1 if (not app.has_account and not app.account_awaiting_confirmation) else 0
                        disabled: app.has_account or app.account_awaiting_confirmation

                        Label:
                            text: app.language and (app.account_mode,) and (app.t('create_account_heading') if app.account_mode == "signup" else app.t('login_heading'))
                            color: app.text_dark
                            bold: True
                            size_hint_y: None
                            height: dp(24)

                        FieldLabel:
                            text: app.language and (app.t('field_name'))
                            size_hint_y: None
                            # composto com "not has_account and not
                            # awaiting_confirmation" (mesma condição do card
                            # inteiro, linha ~3073) — sem isso, esse campo (e os
                            # de baixo) viram fantasma quando o usuário está
                            # logado mas account_mode ainda está "signup" (ver
                            # comentário do ScrollView de avatares mais abaixo
                            # pra entender o mecanismo do bug).
                            height: (self.texture_size[1] if app.account_mode == "signup" else 0) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            opacity: 1 if app.account_mode == "signup" else 0
                        TextInput:
                            id: account_name_input
                            multiline: True
                            size_hint_y: None
                            # sem piso: multiline alinha em cima, um piso maior
                            # que 1 linha sobrava vazio embaixo
                            height: ((min(dp(72), self.minimum_height)) if app.account_mode == "signup" else 0) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            opacity: 1 if app.account_mode == "signup" else 0
                            disabled: app.account_mode != "signup"
                            background_color: app.bg_app
                            foreground_color: app.text_dark

                        FieldLabel:
                            text: app.language and (app.t('field_email'))
                            height: (max(dp(18), self.texture_size[1])) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                        TextInput:
                            id: account_email_input
                            multiline: True
                            size_hint_y: None
                            height: (min(dp(72), self.minimum_height)) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            background_color: app.bg_app
                            foreground_color: app.text_dark

                        FieldLabel:
                            text: app.language and (app.account_mode,) and (app.t('field_password_hint') if app.account_mode == "signup" else app.t('field_password'))
                            height: (max(dp(18), self.texture_size[1])) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                        BoxLayout:
                            size_hint_y: None
                            height: account_password_input.height
                            spacing: dp(6)

                            TextInput:
                                id: account_password_input
                                password: not app.password_visible
                                multiline: True
                                size_hint_y: None
                                height: (min(dp(72), self.minimum_height)) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                                background_color: app.bg_app
                                foreground_color: app.text_dark

                            ClayButton:
                                text: app.language and (app.t('btn_hide_password') if app.password_visible else app.t('btn_show_password'))
                                bg_color: app.accent_soft
                                text_color: app.text_dark
                                size_hint_x: None
                                width: dp(78)
                                on_release: app.toggle_password_visible()

                        # "Esqueci minha senha" como texto clicável logo abaixo
                        # do campo de senha, não como botão de largura inteira:
                        # é uma saída de exceção, não uma ação de mesmo peso que
                        # "Entrar". Só aparece no modo login.
                        TapArea:
                            size_hint_y: None
                            height: (dp(22) if app.account_mode == "login" else 0) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            opacity: 1 if app.account_mode == "login" else 0
                            disabled: app.account_mode != "login"
                            on_release: app.request_password_reset(account_email_input.text)

                            Label:
                                text: app.language and (app.t('btn_forgot_password'))
                                color: app.accent
                                font_size: "11sp"
                                underline: True
                                halign: "right"
                                valign: "middle"
                                text_size: self.size

                        Label:
                            text: app.account_error
                            color: app.danger
                            size_hint_y: None
                            height: (dp(18) if app.account_error else 0) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            font_size: "11sp"

                        ClayButton:
                            text: app.language and (app.account_mode,) and (app.t('create_account_heading') if app.account_mode == "signup" else app.t('login_heading'))
                            bg_color: app.accent
                            size_hint_y: None
                            height: dp(44) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            on_release: app.submit_account_form()

                        ClayButton:
                            text: app.language and (app.account_mode,) and (app.t('btn_have_account') if app.account_mode == "signup" else app.t('btn_need_account'))
                            bg_color: app.bg_card
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(40) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            on_release: app.toggle_account_mode()

                        ClayButton:
                            text: app.language and (app.t('btn_continue_google'))
                            bg_color: app.bg_card
                            text_color: app.muted
                            disabled: True
                            size_hint_y: None
                            # condicionado ao mesmo estado do card (ver comentário
                            # no ScrollView de avatares mais abaixo): sem isso,
                            # fica "fantasma" — invisível mas ainda bloqueando
                            # toque — quando o card colapsa.
                            height: dp(44) if (not app.has_account and not app.account_awaiting_confirmation) else 0

                        Label:
                            text: app.language and (app.t('google_disabled_note'))
                            color: app.muted
                            font_size: "10sp"
                            size_hint_y: None
                            height: dp(30) if (not app.has_account and not app.account_awaiting_confirmation) else 0
                            halign: "center"
                            text_size: self.width, None

                    # cadastro enviado, esperando confirmação real por e-mail
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(16)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height if app.account_awaiting_confirmation else 0
                        opacity: 1 if app.account_awaiting_confirmation else 0
                        disabled: not app.account_awaiting_confirmation

                        Label:
                            text: app.language and (app.t('confirm_email_heading'))
                            color: app.text_dark
                            bold: True
                            size_hint_y: None
                            height: dp(24) if app.account_awaiting_confirmation else 0

                        Label:
                            text: app.language and (app.t('confirm_email_note'))
                            color: app.muted
                            font_size: "11sp"
                            size_hint_y: None
                            height: dp(52) if app.account_awaiting_confirmation else 0
                            halign: "center"
                            valign: "top"
                            text_size: self.width, None

                        Label:
                            text: app.account_error
                            color: app.danger
                            size_hint_y: None
                            height: (dp(18) if app.account_error else 0) if app.account_awaiting_confirmation else 0
                            font_size: "11sp"

                        ClayButton:
                            text: app.language and (app.t('btn_already_confirmed'))
                            bg_color: app.success
                            size_hint_y: None
                            height: dp(44) if app.account_awaiting_confirmation else 0
                            on_release: app.retry_login_after_confirmation()

                    # sessão ativa: mostra e permite editar nome/e-mail
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(16)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height if app.has_account else 0
                        opacity: 1 if app.has_account else 0
                        disabled: not app.has_account

                        # conta logada, enxuta: nome, trocar senha (link no
                        # e-mail), sair — e "apagar conta" discreto no canto.
                        # E-mail só aparece como texto (não se troca por aqui).
                        # Toda altura condiciona em has_account: filho de card
                        # colapsado vira "fantasma" que absorve toque (ver o
                        # comentário do TextInput abaixo)
                        Label:
                            text: app.account_email
                            color: app.muted
                            font_size: "12sp"
                            size_hint_y: None
                            height: dp(18) if app.has_account else 0
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            shorten: True

                        FieldLabel:
                            text: app.language and (app.t('field_name'))
                            height: (max(dp(18), self.texture_size[1])) if app.has_account else 0
                        TextInput:
                            id: profile_name_input
                            text: app.account_name
                            multiline: False
                            size_hint_y: None
                            # TextInput não colapsa sozinho quando o card pai
                            # zera a própria altura — sem condicionar aqui
                            # também, ele vira um campo "fantasma": invisível
                            # mas ainda absorvendo toque, bem em cima de botões
                            # de outra seção da tela.
                            height: dp(40) if app.has_account else 0
                            background_color: app.bg_app
                            foreground_color: app.text_dark

                        Label:
                            text: app.account_error
                            color: app.danger
                            size_hint_y: None
                            height: (self.texture_size[1] + dp(4)) if (app.account_error and app.has_account) else 0
                            text_size: self.width, None
                            font_size: "11sp"

                        Label:
                            text: app.account_status
                            color: app.success
                            size_hint_y: None
                            height: (self.texture_size[1] + dp(4)) if (app.account_status and app.has_account) else 0
                            text_size: self.width, None
                            font_size: "11sp"

                        ClayButton:
                            text: app.language and (app.t('btn_save_name'))
                            bg_color: app.accent
                            size_hint_y: None
                            height: dp(44) if app.has_account else 0
                            on_release: app.save_profile()

                        ClayButton:
                            text: app.language and (app.t('btn_change_password'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(44) if app.has_account else 0
                            on_release: app.pedir_troca_senha()

                        ClayButton:
                            text: app.language and (app.t('btn_logout'))
                            bg_color: app.bg_card
                            text_color: app.danger
                            size_hint_y: None
                            height: dp(44) if app.has_account else 0
                            on_release: app.logout()

                        # apagar conta: pequeno e no canto de propósito — é
                        # irreversível, não pode ser tocado por engano
                        BoxLayout:
                            size_hint_y: None
                            height: dp(24) if app.has_account else 0
                            Widget:
                            TapArea:
                                size_hint_x: None
                                width: apagar_conta_lbl.texture_size[0] + dp(8)
                                disabled: not app.has_account
                                on_release: app.pedir_apagar_conta()
                                Label:
                                    id: apagar_conta_lbl
                                    text: app.language and (app.t('btn_delete_account'))
                                    color: app.muted
                                    font_size: "11sp"
                                    underline: True

                    # exporta/restaura o daily_quest.db inteiro via diálogo nativo (tkinter)
                    ClayCard:
                        id: tut_backup_card
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        FieldLabel:
                            text: app.language and (app.t('backup_section_title'))

                        ClayButton:
                            text: app.language and (app.t('btn_export_backup'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.export_backup()

                        ClayButton:
                            text: app.language and (app.t('btn_import_backup'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.import_backup()

                        # backup preso à conta — Storage do Supabase, ver
                        # README > Backup na Nuvem. Só aparece logado. Nem
                        # SALVAR nem RESTAURAR têm botão: salvar roda sozinho
                        # a cada 12h (App._auto_backup_nuvem) e restaurar roda
                        # sozinho ao entrar na conta (App._apos_entrar ->
                        # restore_from_cloud(automatico=True), chamado nas 4
                        # portas de login). Nenhum dos dois precisa de ação
                        # manual — ver o comentário de _apos_entrar no main.py.
                        FieldLabel:
                            text: app.language and (app.t('backup_cloud_note'))
                            height: dp(18) if app.has_account else 0
                            opacity: 1 if app.has_account else 0

                        Label:
                            text: app.language and (app.t('backup_import_warning'))
                            color: app.muted
                            font_size: "10sp"
                            size_hint_y: None
                            height: dp(16)

                        Label:
                            text: app.backup_status
                            color: app.success
                            bold: True
                            font_size: "11sp"
                            size_hint_y: None
                            height: dp(16) if app.backup_status else 0

                    # só leitura — nenhuma tela nova, abre um popup com o texto
                    ClayCard:
                        bg_color: app.bg_card_soft
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        FieldLabel:
                            text: app.language and (app.t('legal_section_title'))

                        ClayButton:
                            text: app.language and (app.t('btn_privacy_policy'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.open_legal_popup("privacy")

                        ClayButton:
                            text: app.language and (app.t('btn_terms_of_use'))
                            bg_color: app.accent_soft
                            text_color: app.text_dark
                            size_hint_y: None
                            height: dp(42)
                            on_release: app.open_legal_popup("terms")

    # barra de abas embaixo — ícone de linha + rótulo, cor de destaque só na
    # aba ativa, sem pílula preenchida (ver docs/tipografia-e-navegacao.md).
    # Uma linha fina no topo separa do conteúdo. Some durante splash/onboarding.
    BoxLayout:
        id: tut_nav_bar
        size_hint_y: None
        height: 0 if (app.current_screen,) and app.is_onboarding_screen() else dp(60)
        opacity: 0 if (app.current_screen,) and app.is_onboarding_screen() else 1
        disabled: (app.current_screen,) and app.is_onboarding_screen()
        padding: dp(4), dp(6)
        canvas.before:
            Color:
                rgba: app.bg_app
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 0, 0, 0, 0.08
            Line:
                points: self.x, self.top, self.right, self.top
                width: dp(1)

        NavTab:
            kind: "missions"
            label: app.language and (app.t('nav_missions'))
            active: app.current_screen == "missions"
            on_release: app.switch_screen("missions")

        NavTab:
            kind: "history"
            label: app.language and (app.t('nav_history'))
            active: app.current_screen == "history"
            on_release: app.switch_screen("history")

        NavTab:
            kind: "chart"
            label: app.language and (app.t('nav_chart'))
            active: app.current_screen == "chart"
            on_release: app.switch_screen("chart")

        NavTab:
            kind: "badges"
            label: app.language and (app.t('nav_badges'))
            active: app.current_screen == "badges"
            on_release: app.switch_screen("badges")

        NavTab:
            id: tut_settings_tab
            kind: "settings"
            label: app.language and (app.t('nav_settings'))
            active: app.current_screen == "settings"
            on_release: app.switch_screen("settings")

    # espaço reservado pro banner do AdMob (só Android/grátis, ver ads.py). O
    # AdView de verdade é adicionado por cima pelo próprio SDK (gravity BOTTOM),
    # aqui só garantimos que ele não cobre a barra de abas. 0 fora disso.
    Widget:
        size_hint_y: None
        height: dp(50) if app.ad_banner_visible else 0
