#:kivy 2.3.1
#:import TITLE_FONT main.TITLE_FONT
#:import SPLASH_FONT main.SPLASH_FONT
#:import lip widgets.lip
#:import texto_legivel widgets.texto_legivel
#:import Window kivy.core.window.Window
#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# Escala tipográfica — razão 1.2, ancorada no corpo em 14sp. Ver
# docs/tipografia-e-navegacao.md. #:set (constante fixa no load) e não Property:
# tamanho de fonte não muda em runtime, ao contrário das cores do tema.
#:set FS_DISPLAY "28sp"
#:set FS_TITLE "22sp"
#:set FS_HEADING "17sp"
#:set FS_SECTION "12sp"
#:set FS_BODY "14sp"
#:set FS_LABEL "12sp"
#:set FS_CAPTION "11sp"
#:set FS_NAV "10sp"

# Paleta claymorphism: pastel, fosco, sombra dupla pra dar volume "de massinha".
# As cores em si (LIGHT_THEME/DARK_THEME) vivem em main.py como Properties do App,
# não como #:set daqui — só assim o modo escuro consegue trocar tudo em tempo real.


<TextInput>:
    # tira a textura degradê padrão do Kivy, deixa a cor sólida que cada campo já define
    background_normal: ""
    background_active: ""
    cursor_color: app.accent


<ClayCard>:
    # card estilo Duolingo: borda de 2dp e um "lábio" de 4dp embaixo, na mesma
    # cor (widgets.lip) — é o que dá a sensação de peça em relevo
    canvas.before:
        Color:
            rgba: lip(self.bg_color, app.text_dark)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.x + dp(2), self.y + dp(4)
            size: self.width - dp(4), self.height - dp(6)
            radius: [dp(14)]


<ClayButton>:
    # botão 3D estilo Duolingo: a face fica em cima de um "lábio" de 4dp mais
    # escuro; pressionado, a face DESCE e cobre o lábio, como uma tecla. O
    # padding acompanha (4dp saem de baixo e vão pro topo) pra o texto descer
    # junto com a face.
    padding: (dp(10), dp(14), dp(10), dp(10)) if self.state == "down" else (dp(10), dp(10), dp(10), dp(14))
    canvas.before:
        Color:
            rgba: lip(self.bg_color, app.text_dark)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.x, self.y + (0 if self.state == "down" else dp(4))
            size: self.width, self.height - dp(4)
            radius: [dp(14)]
    Label:
        # "(root.text,) and": sem citar root.text sozinho, o kv não religa o
        # bind através do .upper() — o Label ficava com o texto vazio da criação
        text: (root.text,) and root.text.upper()
        # troca pra escuro/branco sozinho se a cor pedida some no fundo
        # (ex.: texto branco num destaque verde-claro da cor personalizada)
        color: texto_legivel(root.bg_color, root.text_color)
        bold: True
        font_size: root.font_size
        on_size: root.fit_font_size(self.width)
        on_text: root.fit_font_size(self.width)


# aba da barra inferior: ícone de linha (canvas) + rótulo embaixo. Sem
# fundo/pílula — só a cor muda entre ativa (accent) e inativa (muted).
<NavTab>:
    orientation: "vertical"
    spacing: dp(2)
    padding: 0, dp(4)
    opacity: 0.6 if self.state == "down" else 1
    # aba ativa em caixinha contornada, como a navegação do Duolingo
    canvas.before:
        Color:
            rgba: (app.accent[0], app.accent[1], app.accent[2], 0.14) if self.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(6), self.y + dp(2)
            size: self.width - dp(12), self.height - dp(4)
            radius: [dp(12)]
        Color:
            rgba: app.accent if self.active else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x + dp(6), self.y + dp(2), self.width - dp(12), self.height - dp(4), dp(12))
            width: dp(1.4)
    NavIcon:
        kind: root.kind
        color: app.accent if root.active else app.muted
        size_hint_y: None
        height: dp(24)
    Label:
        text: root.label
        color: app.accent if root.active else app.muted
        bold: root.active
        font_size: FS_NAV
        halign: "center"
        valign: "top"
        text_size: self.width, None
        shorten: True


<ClayCardButton>:
    # mesmo card em relevo do ClayCard; pressionado, afunda sobre o lábio
    canvas.before:
        Color:
            rgba: lip(self.bg_color, app.text_dark)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.x + dp(2), self.y + (dp(2) if self.state == "down" else dp(4))
            size: self.width - dp(4), self.height - dp(6)
            radius: [dp(14)]
    canvas.after:
        # setinha no canto — indica "isto é clicável, leva pra outro lugar"
        # (mesma ideia da seta do ClaySpinner, só que apontando pro lado)
        Color:
            rgba: app.text_dark[0], app.text_dark[1], app.text_dark[2], 0.45
        Triangle:
            points:
                self.right - dp(16), self.top - dp(10),\
                self.right - dp(16), self.top - dp(18),\
                self.right - dp(10), self.top - dp(14)


<ClayCheck>:
    size_hint: None, None
    size: dp(42), dp(42)
    canvas.before:
        Color:
            rgba: app.success if self.checked else (0, 0, 0, 0)
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.success if self.checked else app.muted
        Line:
            ellipse: (self.x, self.y, self.width, self.height)
            width: dp(1.5)
    Label:
        text: "OK" if root.checked else ""
        color: texto_legivel(app.success, app.text_light)
        bold: True
        font_size: "11sp"


<DayToggle>:
    size_hint: None, None
    size: dp(34), dp(34)
    canvas.before:
        Color:
            rgba: app.accent if self.active else (0, 0, 0, 0)
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.accent if self.active else app.muted
        Line:
            ellipse: (self.x, self.y, self.width, self.height)
            width: dp(1.5)
    Label:
        text: root.label_text
        color: texto_legivel(app.accent, app.text_light) if root.active else app.text_dark
        bold: True
        font_size: "12sp"


<ClaySpinner>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: app.text_dark
    halign: "left"
    valign: "middle"
    padding: dp(16), 0
    text_size: self.width - dp(40), None
    bold: True
    canvas.before:
        # mesmo relevo dos botões (lábio de 4dp embaixo)
        Color:
            rgba: lip(app.accent_soft, app.text_dark)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: app.accent_soft
        RoundedRectangle:
            pos: self.x, self.y + dp(4)
            size: self.width, self.height - dp(4)
            radius: [dp(14)]
        # seta indicando "isto abre uma lista de opções" (o Spinner de fábrica
        # tinha uma seta assim, sumiu quando a gente tirou a textura padrão)
        Color:
            rgba: app.text_dark
        Triangle:
            points:
                self.right - dp(24), self.center_y + dp(3),\
                self.right - dp(14), self.center_y + dp(3),\
                self.right - dp(19), self.center_y - dp(3)


<DropDown>:
    # o painel do dropdown não tinha fundo próprio — o conteúdo atrás (o resto da
    # tela) vazava pelos vãos entre as opções arredondadas de baixo. Um fundo
    # sólido único pra lista inteira resolve de raiz.
    canvas.before:
        Color:
            rgba: app.bg_card_soft
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]


<SpinnerOption>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: app.text_dark
    bold: True
    font_size: "14sp"
    canvas.before:
        # opção encostada na vizinha (sem vão) + realce quando o dedo/mouse
        # está em cima, só uma linha fina separando uma da outra
        Color:
            rgba: app.accent_soft if self.state == "down" else app.bg_card_soft
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.10
        Line:
            points: self.x, self.y, self.right, self.y
            width: 1


<ClayProgressBar>:
    size_hint_y: None
    height: dp(18)
    canvas:
        Color:
            rgba: app.bg_card
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: app.accent
        RoundedRectangle:
            pos: self.pos
            size: (max(self.height, self.width * self.value), self.height)
            radius: [self.height / 2]
        # faixa de brilho no terço de cima do preenchimento (a da barra do Duolingo)
        Color:
            rgba: 1, 1, 1, 0.28 if self.value > 0 else 0
        RoundedRectangle:
            pos: self.x + dp(6), self.top - self.height * 0.42
            size: (max(0, self.width * self.value - dp(12)), self.height * 0.22)
            radius: [self.height * 0.11]


<AvatarThumb>:
    size_hint: None, None
    size: dp(64), dp(64)
    disabled: not self.unlocked
    canvas.before:
        Color:
            rgba: app.accent if app.profile_avatar == self.avatar_id else app.bg_card
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    Image:
        source: root.img_path
        pos: root.x + dp(4), root.y + dp(4)
        size: root.width - dp(8), root.height - dp(8)
        allow_stretch: True
        keep_ratio: True
        opacity: 1 if root.unlocked else 0.4

    # cadeado sobre poses ainda não desbloqueadas — selo pequeno no canto (não
    # cobrindo a pose inteira, senão dava pra ver quase nada do Focum por trás)
    Image:
        source: app.LOCK_ICON
        size_hint: None, None
        size: dp(22), dp(22)
        pos: root.right - dp(24), root.y + dp(2)
        opacity: 0 if root.unlocked else 1
        allow_stretch: True
        keep_ratio: True


<FrameThumb>:
    size_hint: None, None
    size: dp(34), dp(34)
    disabled: not self.unlocked
    canvas.before:
        Color:
            rgba: root.frame_color
        Line:
            ellipse: (self.x, self.y, self.width, self.height)
            width: dp(2) if (app.app_icon if root.action == "icon" else app.profile_frame) == root.frame_id else dp(1.2)

    Image:
        source: app.LOCK_ICON
        size_hint: None, None
        size: dp(14), dp(14)
        pos: root.right - dp(14), root.y
        opacity: 0 if root.unlocked else 1
        allow_stretch: True
        keep_ratio: True


<MissionRow@BoxLayout>:
    mission_id: 0
    text_name: ""
    text_periodicity: ""
    text_difficulty: ""
    difficulty_key: "facil"
    points: 0
    is_challenge: False  # veio de um Desafio — ganha CHALLENGE_MULTIPLIER ao concluir
    done: False
    scheduled: True  # False = diária com dias específicos, e hoje não é um deles
    size_hint_y: None
    height: dp(76)
    padding: dp(6), 0
    opacity: 1 if root.scheduled else 0.5

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(12)
        spacing: dp(8)

        ClayCheck:
            mission_id: root.mission_id
            checked: root.done
            disabled: not root.scheduled

        TapArea:
            orientation: "vertical"
            spacing: dp(3)
            on_release: app.open_mission_details(root.mission_id)
            Label:
                text: root.text_name
                color: app.text_dark
                bold: True
                font_size: "17sp"
                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True
                shorten_from: "right"

            # linha de etiquetas — periodicidade em texto discreto + badge de
            # dificuldade colorido (inspirado nas tags de categoria/oferta da Amazon)
            BoxLayout:
                size_hint_y: None
                height: dp(20)
                spacing: dp(6)

                Label:
                    text: root.text_periodicity
                    color: app.muted
                    font_size: "11sp"
                    size_hint_x: None
                    width: self.texture_size[0]
                    halign: "left"
                    valign: "middle"
                    text_size: None, self.height

                BoxLayout:
                    size_hint_x: None
                    width: dp_label.texture_size[0] + dp(16)
                    canvas.before:
                        Color:
                            rgba: app.difficulty_color(root.difficulty_key)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]
                    Label:
                        id: dp_label
                        text: root.text_difficulty
                        color: texto_legivel(app.difficulty_color(root.difficulty_key), app.text_light)
                        bold: True
                        font_size: "10sp"

                # selo do multiplicador de Desafio — mesma receita do badge de
                # dificuldade (RoundedRectangle + Label), só que colapsa (width 0)
                # quando a missão não veio de um Desafio
                BoxLayout:
                    size_hint_x: None
                    width: (ch_label.texture_size[0] + dp(16)) if root.is_challenge else 0
                    canvas.before:
                        Color:
                            rgba: app.success
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]
                    Label:
                        id: ch_label
                        text: (app.language and app.t('badge_challenge_multiplier')) if root.is_challenge else ""
                        color: texto_legivel(app.success, app.text_light)
                        bold: True
                        font_size: "10sp"
                        opacity: 1 if root.is_challenge else 0

        # etiqueta de pontos, estilo preço — número grande em destaque, unidade
        # pequena embaixo, mesma ideia da Amazon de "o número que importa" primeiro
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: dp(46)
            Label:
                text: "+" + str(root.points)
                color: app.accent
                bold: True
                font_size: "18sp"
            Label:
                text: app.language and (app.t('point_plural'))
                color: app.muted
                font_size: "9sp"
                size_hint_y: None
                height: dp(12)

        ClayButton:
            text: app.language and (app.t('btn_edit'))
            bg_color: app.accent_soft
            text_color: app.text_dark
            size_hint_x: None
            width: dp(64)
            on_release: app.open_edit_popup(root.mission_id)

        ClayButton:
            text: "×"
            bg_color: app.danger
            size_hint_x: None
            width: dp(40)
            on_release: app.on_remove_mission(root.mission_id)


<RewardRow@BoxLayout>:
    reward_id: 0
    reward_name: ""
    cost: 0
    size_hint_y: None
    height: dp(64)
    padding: dp(6), 0

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(12)
        spacing: dp(6)

        # toque no nome/custo abre edição — mesmo padrão do MissionRow (o
        # TapArea fica só na área de texto, nunca envolvendo outro botão,
        # senão o toque conflita com Resgatar/× por dentro)
        TapArea:
            orientation: "vertical"
            on_release: app.open_edit_reward_popup(root.reward_id)

            Label:
                text: root.reward_name
                color: app.text_dark
                bold: True
                font_size: "15sp"
                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True

            Label:
                text: str(root.cost) + " " + app.points_word(root.cost)
                color: app.accent
                font_size: "12sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

        ClayButton:
            text: app.language and (app.t('btn_redeem'))
            bg_color: app.accent
            disabled: app.available_points < root.cost
            opacity: 1 if app.available_points >= root.cost else 0.5
            size_hint_x: None
            width: dp(84)
            on_release: app.redeem_reward(root.reward_id)

        ClayButton:
            text: "×"
            bg_color: app.danger
            size_hint_x: None
            width: dp(36)
            on_release: app.on_remove_reward(root.reward_id)


<RewardHistoryRow@BoxLayout>:
    reward_name: ""
    cost: 0
    redeemed_at: ""
    size_hint_y: None
    height: dp(38)

    ClayCard:
        bg_color: app.bg_card
        orientation: "horizontal"
        padding: dp(10)

        Label:
            text: root.reward_name
            color: app.text_dark
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True

        Label:
            text: "-" + str(root.cost)
            color: app.danger
            bold: True
            size_hint_x: None
            width: dp(46)
            halign: "right"
            valign: "middle"
            text_size: self.size

        Label:
            text: root.redeemed_at
            color: app.muted
            font_size: "11sp"
            size_hint_x: None
            width: dp(44)
            halign: "right"
            valign: "middle"
            text_size: self.size


<SuggestionRow@BoxLayout>:
    sugg_id: ""
    text_name: ""
    text_periodicity: ""
    text_difficulty: ""
    difficulty_key: "facil"
    already_added: False  # já existe uma missão com esse sugg_id — vira "X" (ver main.py > added_suggestion_ids)
    size_hint_y: None
    height: dp(60)
    padding: dp(4), 0

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(10)
        spacing: dp(8)

        BoxLayout:
            orientation: "vertical"
            spacing: dp(2)

            Label:
                text: root.text_name
                color: app.text_dark
                bold: True
                font_size: "13sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(16)
                spacing: dp(6)

                Label:
                    text: root.text_periodicity
                    color: app.muted
                    font_size: "10sp"
                    size_hint_x: None
                    width: self.texture_size[0]
                    text_size: None, self.height

                BoxLayout:
                    size_hint_x: None
                    width: sugg_dp_label.texture_size[0] + dp(14)
                    canvas.before:
                        Color:
                            rgba: app.difficulty_color(root.difficulty_key)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(7)]
                    Label:
                        id: sugg_dp_label
                        text: root.text_difficulty
                        color: texto_legivel(app.difficulty_color(root.difficulty_key), app.text_light)
                        bold: True
                        font_size: "9sp"

        ClayButton:
            text: "X" if root.already_added else "+"
            bg_color: app.muted if root.already_added else app.accent
            disabled: root.already_added
            size_hint_x: None
            width: dp(40)
            on_release: app.add_suggested_mission(root)


<ChallengeRow@BoxLayout>:
    challenge_id: ""
    text_name: ""
    text_desc: ""
    already_added: False  # todas as missões desse desafio já foram adicionadas — vira "X" (ver main.py > added_challenge_ids)
    size_hint_y: None
    height: dp(76)
    padding: dp(4), 0

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(10)
        spacing: dp(8)

        BoxLayout:
            orientation: "vertical"
            spacing: dp(2)

            Label:
                text: root.text_name
                color: app.text_dark
                bold: True
                font_size: "14sp"
                halign: "left"
                valign: "top"
                text_size: self.size

            Label:
                text: root.text_desc
                color: app.muted
                font_size: "11sp"
                halign: "left"
                valign: "top"
                text_size: self.size

        ClayButton:
            text: "X" if root.already_added else (app.language and app.t('btn_add_all'))
            bg_color: app.muted if root.already_added else app.accent
            disabled: root.already_added
            size_hint_x: None
            width: dp(76)
            on_release: app.add_challenge(root)


# cabeçalho de seção — bold, CAIXA ALTA, discreto (ver doc). O Kivy não
# transforma texto: SEMPRE passe a string já com .upper().
<SectionLabel@Label>:
    color: app.muted
    bold: True
    font_size: FS_SECTION
    size_hint_y: None
    height: dp(28)
    padding: dp(6), dp(6)
    halign: "left"
    valign: "bottom"
    text_size: self.size


# apelido: mesmo visual de SectionLabel, nome mantido pelas telas de histórico
<HistorySectionLabel@SectionLabel>:
    size_hint_y: None


<HistoryRow@BoxLayout>:
    mission_name: ""
    periodicity_text: ""
    obs_text: ""
    points_text: ""
    date_text: ""
    size_hint_y: None
    height: dp(72) if root.obs_text else dp(56)
    padding: dp(6), 0

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(12)
        spacing: dp(8)

        BoxLayout:
            orientation: "vertical"
            spacing: dp(2)

            Label:
                text: root.mission_name
                color: app.text_dark
                bold: True
                font_size: "13sp"
                halign: "left"
                valign: "top"
                text_size: self.size

            Label:
                text: root.periodicity_text
                color: app.muted
                font_size: "10sp"
                halign: "left"
                valign: "top"
                text_size: self.size
                size_hint_y: None
                height: dp(15)

            Label:
                text: root.obs_text
                color: app.muted
                italic: True
                font_size: "10sp"
                halign: "left"
                valign: "top"
                text_size: self.size
                size_hint_y: None
                height: dp(15) if root.obs_text else 0

        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: dp(56)

            Label:
                text: root.points_text
                color: app.success
                bold: True
                font_size: "14sp"
                halign: "right"
                valign: "top"
                text_size: self.size

            Label:
                text: root.date_text
                color: app.muted
                font_size: "10sp"
                halign: "right"
                valign: "bottom"
                text_size: self.size


<MonthStatRow@BoxLayout>:
    month_label: ""
    points_label: ""
    size_hint_y: None
    height: dp(44)
    padding: dp(4), 0

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(12)

        Label:
            text: root.month_label
            color: app.text_dark
            bold: True
            font_size: "13sp"
            halign: "left"
            valign: "middle"
            text_size: self.size

        Label:
            text: root.points_label
            color: app.accent
            bold: True
            font_size: "13sp"
            halign: "right"
            valign: "middle"
            text_size: self.size


<MissionStatRow@BoxLayout>:
    mission_name: ""
    completions_label: ""
    points_label: ""
    size_hint_y: None
    # a linha CRESCE com o conteúdo em vez de ficar presa em dp(44): "9 Pontos
    # no Mês" não cabia numa linha só na coluna da direita, quebrava em duas e
    # a segunda vazava pra fora do cartão (ficava cortada na tela). Idem pra
    # idioma mais comprido (o alemão é bem maior que o português).
    height: max(dp(44), pontos.texture_size[1] + dp(24), nome.texture_size[1] + dp(24))
    padding: dp(4), 0

    ClayCard:
        bg_color: app.bg_card_soft
        orientation: "horizontal"
        padding: dp(12)
        spacing: dp(6)

        Label:
            id: nome
            text: root.mission_name
            color: app.text_dark
            bold: True
            font_size: "13sp"
            halign: "left"
            valign: "middle"
            # largura fixa + altura livre: quebra em 2 linhas se o nome for
            # longo e a linha inteira acompanha (ver height do root)
            text_size: self.width, None

        Label:
            text: root.completions_label
            color: app.muted
            font_size: "12sp"
            size_hint_x: None
            width: dp(40)
            halign: "right"
            valign: "middle"
            text_size: self.size

        Label:
            id: pontos
            text: root.points_label
            color: app.accent
            bold: True
            font_size: "12sp"
            size_hint_x: None
            width: dp(96)
            halign: "right"
            valign: "middle"
            text_size: self.width, None


<BadgeCard@BoxLayout>:
    name_text: ""
    desc_text: ""
    unlocked: False
    preview_img: ""  # pose do Focum que essa conquista libera — "" quando não há uma
    preview_frame_color: [0, 0, 0, 0]  # moldura que a conquista libera (anel) quando não há pose
    badge_id: ""  # pra abrir os detalhes (e equipar como título) ao tocar
    orientation: "vertical"
    size_hint_y: None
    height: dp(120)
    padding: dp(4)

    TapArea:
        orientation: "horizontal"
        on_release: app.open_badge_details(root.badge_id)

        ClayCard:
            bg_color: app.accent_soft if root.unlocked else app.bg_card
            orientation: "horizontal"
            padding: dp(12)
            spacing: dp(8)

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)

                Label:
                    text: root.name_text
                    color: app.text_dark if root.unlocked else app.muted
                    bold: True
                    font_size: "13sp"
                    halign: "left"
                    valign: "top"
                    text_size: self.size

                Label:
                    text: root.desc_text
                    color: app.muted
                    font_size: "11sp"
                    halign: "left"
                    valign: "top"
                    text_size: self.size

                Label:
                    text: "" if root.unlocked else app.t('badge_locked')
                    color: app.danger
                    bold: True
                    font_size: "10sp"
                    size_hint_y: None
                    height: dp(14) if not root.unlocked else 0
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

            # prévia da recompensa: pose do Focum, OU a moldura (anel colorido)
            # quando o emblema libera moldura em vez de pose (multiplicador de
            # sequência — ver mascot.reward_frame_color). Esmaece enquanto
            # bloqueada — um "gostinho" do que vem a seguir.
            Widget:
                size_hint: None, None
                size: (dp(52), dp(52)) if (root.preview_img or (root.preview_frame_color or (0, 0, 0, 0))[3]) else (0, 0)
                opacity: 1 if root.unlocked else 0.4
                canvas.after:
                    Color:
                        rgba: root.preview_frame_color or (0, 0, 0, 0)
                    Line:
                        ellipse: (self.x + dp(4), self.y + dp(4), self.width - dp(8), self.height - dp(8))
                        width: dp(1.6)
                # só entra quando há pose — Image de source vazio pinta um
                # retângulo branco (textura None + Color branco), era esse o
                # "fundo" atrás do anel da moldura
                Image:
                    source: root.preview_img
                    pos: self.parent.pos
                    size: self.parent.size if root.preview_img else (0, 0)
                    allow_stretch: True
                    keep_ratio: True


<FieldLabel@Label>:
    color: app.muted
    bold: True
    font_size: FS_LABEL
    size_hint_y: None
    # altura cresce com o texto (alguns rótulos, tipo o de requisitos de
    # senha, quebram em 2 linhas) — texture_size[1] já dá ~18dp numa linha
    # só, então os rótulos curtos ficam do jeito que sempre foram
    height: max(dp(18), self.texture_size[1])
    halign: "left"
    valign: "middle"
    text_size: self.width, None


<MissionFormPopup>:
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.accent
    background: ""
    background_color: app.bg_app
    # fração da tela (não dp fixo) — o conteúdo cresceu (instruções + lembrete
    # por missão) e varia demais (diária com dias específicos, Premium ou não)
    # pra um número mágico continuar dando certo; o ScrollView de dentro cuida
    # do que não couber
    size_hint: 0.88, 0.85

    ScrollView:
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: dp(16)
            spacing: dp(12)

            ClayCard:
                bg_color: app.bg_card_soft
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(6)
                size_hint_y: None
                height: self.minimum_height

                FieldLabel:
                    text: app.language and (app.t('field_name'))

                TextInput:
                    id: name_input
                    hint_text: app.language and (app.t('mission_name_hint'))
                    multiline: False
                    # "null" desliga sugestão/correção do teclado — sem isso,
                    # editar um nome pré-preenchido (não dá em campo vazio) às
                    # vezes trava o backspace no Android: teclados como Gboard
                    # apagam texto existente via uma chamada de IME (compose/
                    # commit), não uma tecla crua, e o Kivy 2.3.1 nem sempre
                    # roteia isso pro TextInput. Selecionar tudo e digitar por
                    # cima funciona (manda o texto inteiro de uma vez) — só o
                    # apagar incremental que travava.
                    input_type: "null"
                    size_hint_y: None
                    height: dp(42)
                    background_color: app.bg_app
                    foreground_color: app.text_dark
                    padding: dp(10), dp(10)

                FieldLabel:
                    text: app.language and (app.t('field_periodicity'))

                ClaySpinner:
                    id: periodicity_spinner
                    values: app.language and app.periodicity_values()
                    size_hint_y: None
                    height: dp(42)
                    on_text: root.is_daily = app.is_periodicity_daily(self.text)

                FieldLabel:
                    text: app.language and (app.t('field_difficulty'))

                ClaySpinner:
                    id: difficulty_spinner
                    values: app.language and app.difficulty_values()
                    size_hint_y: None
                    height: dp(42)

                # "nos meus dias de folga" e "dias específicos" são mutuamente
                # exclusivos (ver confirm() em main.py) — só some se existir um
                # ciclo pessoal configurado (app.cycle_enabled, ver Ajustes)
                ClayButton:
                    text: app.language and (app.t('field_follow_cycle'))
                    bg_color: app.accent if root.follow_cycle else app.accent_soft
                    text_color: app.text_light if root.follow_cycle else app.text_dark
                    size_hint_y: None
                    height: (dp(38) if app.cycle_enabled else 0) if root.is_daily else 0
                    opacity: (1 if app.cycle_enabled else 0) if root.is_daily else 0
                    disabled: (not app.cycle_enabled) if root.is_daily else True
                    on_release: root.follow_cycle = not root.follow_cycle

                FieldLabel:
                    text: app.language and (app.t('field_specific_days'))
                    opacity: (1 if not root.follow_cycle else 0) if root.is_daily else 0
                    height: (dp(18) if not root.follow_cycle else 0) if root.is_daily else 0

                BoxLayout:
                    id: day_toggles
                    size_hint_y: None
                    height: (dp(34) if not root.follow_cycle else 0) if root.is_daily else 0
                    opacity: (1 if not root.follow_cycle else 0) if root.is_daily else 0
                    disabled: (root.follow_cycle) if root.is_daily else True
                    spacing: dp(4)

                # texto livre — ex.: os exercícios de um treino (mostrado
                # depois na aba de detalhes, ao tocar na missão)
                FieldLabel:
                    text: app.language and (app.t('field_instructions'))

                TextInput:
                    id: instructions_input
                    hint_text: app.language and (app.t('instructions_hint'))
                    multiline: True
                    size_hint_y: None
                    # sem piso: multiline alinha em cima, um piso maior que o
                    # texto sobrava vazio embaixo. Só teto, pra não crescer demais.
                    height: min(dp(120), self.minimum_height)
                    background_color: app.bg_app
                    foreground_color: app.text_dark
                    padding: dp(10), dp(10)

                # lembrete individual — recurso Premium (ver README > Monetização);
                # spinners ficam desabilitados (não escondidos) pra quem não é
                # Premium, mesma ideia da cor personalizada em Ajustes
                FieldLabel:
                    text: app.language and (app.t('field_mission_reminder') + ("" if app.is_premium else (" — " + app.t('label_premium_only'))))

                BoxLayout:
                    size_hint_y: None
                    height: dp(42)
                    spacing: dp(8)
                    disabled: not app.is_premium

                    ClayButton:
                        text: root.reminder_escolhido or (app.language and app.t('reminder_none'))
                        bg_color: app.bg_card
                        text_color: app.text_dark
                        on_release: root.escolher_horario()

                    ClayButton:
                        text: "X"
                        bg_color: app.bg_card_soft
                        text_color: app.muted
                        size_hint_x: None
                        width: dp(48)
                        disabled: not root.reminder_escolhido
                        on_release: root.reminder_escolhido = ""

            ClayCard:
                bg_color: app.accent_soft
                size_hint_y: None
                height: dp(44)
                Label:
                    text: app.language and (app.t('points_worth_prefix') + " " + str(app.points_for(periodicity_spinner.text, difficulty_spinner.text)) + " " + app.points_word(app.points_for(periodicity_spinner.text, difficulty_spinner.text)))
                    color: app.text_dark
                    bold: True

            Label:
                text: root.limit_error
                color: app.danger
                font_size: "11sp"
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: (self.texture_size[1] + dp(4)) if root.limit_error else 0

            ClayButton:
                id: confirm_button
                bg_color: app.accent
                size_hint_y: None
                height: dp(48)
                on_release: root.confirm()


<CompleteMissionPopup>:
    title: app.language and (app.t('popup_complete_title'))
    title_color: app.text_dark
    title_align: "center"
    separator_color: app.success
    background: ""
